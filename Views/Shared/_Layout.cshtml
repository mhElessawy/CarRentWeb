@using Microsoft.AspNetCore.Http
@using CarRentWeb.Models.MyModel
@using CarRentWeb.Models
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
@{
    var user = HttpContextAccessor.HttpContext!.Session.GetObjectFromJson<PasswordDatum>("CurrentUser");
}

<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>شركة أجرة الزاجل  الدولي الجوال</title>
    <meta name="description" content="">
    <meta name="keywords" content="">

    <!-- Favicons -->
    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Poppins:wght@300;400;500;600;700&family=Raleway:wght@300;400;500;600;700&family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link href="~/assets/css/mhStyle.css" rel="stylesheet">
</head>
<body>
    <!-- ===== FIRST BAR: Logo + User Info + Logout ===== -->
    <nav class="navbar-top-first">
        <div class="container-fluid px-4">
            <div class="d-flex justify-content-between align-items-center">
                <!-- Logo / Brand -->
                <a asp-action="Index" asp-controller="Home" class="brand-link">
                    <i class="bi bi-car-front-fill brand-icon"></i>
                    <span class="brand-name">شركة أجرة الزاجل  الدولي الجوال</span>
                </a>
                <!-- User Info + Logout -->
                <div class="d-flex align-items-center gap-3">
                    <span class="user-info">
                        <i class="bi bi-person-circle"></i>
                        @TempData["Username"]
                    </span>
                    <a asp-action="Login" asp-controller="PasswordDatums" class="btn-logout">
                        <i class="bi bi-box-arrow-left"></i>
                        تسجيل خروج
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- ===== SECOND BAR: Menu Categories (Horizontal Tabs) ===== -->
    <nav class="navbar-top-second">
        <div class="container-fluid px-4">
            <!-- Mobile Toggle Button -->
            <button class="mobile-menu-toggle d-xl-none" onclick="toggleMobileMenu()">
                <i class="bi bi-list"></i>
                القائمة
            </button>
            <ul class="nav-menu" id="navMenu">
                <!-- الموظفين -->
                <li class="nav-item has-dropdown">
                    <a href="#" class="nav-tab">
                        <i class="bi bi-people-fill"></i>
                        الموظفين
                        <i class="bi bi-chevron-down arrow"></i>
                    </a>
                    <ul class="dropdown-menu-custom">
                        @if (user!.EmpView == true)
                        {
                            <li><a asp-action="Index" asp-controller="EmployeeInfoes"><i class="bi bi-person-lines-fill"></i> بيانات الموظفين</a></li>
                        }
                        @if (user!.DebitView == true)
                        {
                            <li class="has-submenu">
                                <a href="#"><i class="bi bi-cash-stack"></i> الديون <i class="bi bi-chevron-left submenu-arrow"></i></a>
                                <ul class="submenu">
                                    <li><a asp-action="Index" asp-controller="DebitInfoes">إضافة وإستلام دين</a></li>
                                    <li><a href="#">إضافة ديون جماعية</a></li>
                                </ul>
                            </li>
                        }
                        @if (user.PayView == true)
                        {
                            <li><a asp-action="Index" asp-controller="ContractDetails"><i class="bi bi-calendar-month"></i> الإيجار الشهري و المتأخر</a></li>
                        }
                        @if (user.VacationView == true)
                        {
                            <li><a asp-action="Index" asp-controller="Vacations"><i class="bi bi-calendar-check"></i> الأجازات</a></li>
                        }
                        @if (user.EmpTakeMoney == true)
                        {
                            <li><a asp-action="Index" asp-controller="EmployeeTakeMoneys"><i class="bi bi-wallet2"></i> العهد</a></li>
                        }
                        @if (user.EmpArchive == true)
                        {
                            <li><a asp-action="Index" asp-controller="EmployeeInfoes"><i class="bi bi-archive"></i> أرشيف الموظفين</a></li>
                        }
                        @if (user.RecievedMoney == true)
                        {
                            <li><a asp-action="RecievedMoney" asp-controller="EmployeeInfoes"><i class="bi bi-cash-coin"></i> استلام المبالغ</a></li>
                        }
                      @*   @if (user.CompDebitView == true)
                        {
                            <li><a asp-action="Index" asp-controller="CompanyDebits"><i class="bi bi-building-exclamation"></i> ديون الشركات</a></li>
                        }
                        <li class="has-submenu">
                            <a href="#"><i class="bi bi-currency-dollar"></i> الرواتب <i class="bi bi-chevron-left submenu-arrow"></i></a>
                            <ul class="submenu">
                                <li><a asp-action="Index" asp-controller="EmployeeSalaries">إضافة راتب</a></li>
                            </ul>
                        </li> *@
                    </ul>
                </li>

                <!-- السيارات -->
                <li class="nav-item has-dropdown">
                    <a href="#" class="nav-tab">
                        <i class="bi bi-car-front"></i>
                        السيارات
                        <i class="bi bi-chevron-down arrow"></i>
                    </a>
                    <ul class="dropdown-menu-custom">
                        @if (user!.CarView == true)
                        {
                            <li><a asp-action="Index" asp-controller="CarInfoes"><i class="bi bi-car-front-fill"></i> بيانات السيارات</a></li>
                        }
                        <li><a asp-action="IndexCredit" asp-controller="Contracts"><i class="bi bi-credit-card"></i> أقساط السيارات</a></li>
                        @if (user.ViolationView == true)
                        {
                            <li><a asp-action="Index" asp-controller="ViolationInfoes"><i class="bi bi-exclamation-triangle"></i> المخالفات</a></li>
                        }
                        <li><a asp-action="IndexCredit" asp-controller="Contracts"><i class="bi bi-archive"></i> أرشيف السيارات</a></li>
                    </ul>
                </li>

                <!-- العقود -->
                <li class="nav-item has-dropdown">
                    <a href="#" class="nav-tab">
                        <i class="bi bi-file-earmark-text"></i>
                        العقود
                        <i class="bi bi-chevron-down arrow"></i>
                    </a>
                    <ul class="dropdown-menu-custom">
                        @if (user!.ContractDailyView == true)
                        {
                            <li><a asp-action="IndexDaily" asp-controller="Contracts"><i class="bi bi-calendar-day"></i> العقود اليومية</a></li>
                        }
                        @if (user!.ContractMonthlyView == true)
                        {
                            <li><a asp-action="IndexMonthly" asp-controller="Contracts"><i class="bi bi-calendar-month"></i> العقود الشهرية</a></li>
                        }
                        @if (user!.ContractArchive == true)
                        {
                            <li><a asp-action="IndexArchive" asp-controller="Contracts"><i class="bi bi-archive"></i> أرشبف العقود</a></li>
                        }
                    </ul>
                </li>

                <!-- الشركات -->
                @if (user.CompView == true)
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="CompanyInfoes" class="nav-tab">
                            <i class="bi bi-building"></i>
                            الشركات
                        </a>
                    </li>
                }

                <!-- المصروفات -->
                @if (user.PurshaseView == true)
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Purshases" class="nav-tab">
                            <i class="bi bi-receipt"></i>
                            المصروفات
                        </a>
                    </li>
                }

                <!-- مسئول البرنامج -->
                @if (user.UserAdmin == true)
                {
                    <li class="nav-item has-dropdown">
                        <a href="#" class="nav-tab">
                            <i class="bi bi-gear-fill"></i>
                            مسئول البرنامج
                            <i class="bi bi-chevron-down arrow"></i>
                        </a>
                        <ul class="dropdown-menu-custom">
                            <li><a asp-action="Index" asp-controller="PasswordDatums"><i class="bi bi-people"></i> المستخدمين</a></li>
                            <li><a href="#"><i class="bi bi-eye"></i> متابعة المستخدمين</a></li>
                            <li><a asp-controller="Home" asp-action="DeffTypeIndex" asp-route-pageIndex="1"><i class="bi bi-list-check"></i> التعريفات</a></li>
                            <li><a asp-controller="DeffInformations" asp-action="Edit" asp-route-Id="1"><i class="bi bi-info-circle"></i> البيانات العامة</a></li>
                        </ul>
                    </li>
                }

                <!-- التقارير -->
                <li class="nav-item has-dropdown">
                    <a href="#" class="nav-tab">
                        <i class="bi bi-bar-chart-line"></i>
                        التقارير
                        <i class="bi bi-chevron-down arrow"></i>
                    </a>
                    <ul class="dropdown-menu-custom">
                        <li><a asp-action="Index" asp-controller="Bills"><i class="bi bi-cash"></i> التحصيل</a></li>
                        <li><a asp-action="IndexReport" asp-controller="DebitPayInfoes"><i class="bi bi-cash-stack"></i> تحصيل الديون</a></li>
                @*         <li><a asp-action="IndexReport" asp-controller="DebitInfoes"><i class="bi bi-plus-circle"></i> إضافة ديون</a></li> *@
                        <li><a asp-action="IndexReport" asp-controller="Purshases"><i class="bi bi-receipt-cutoff"></i> المصاريف</a></li>
                        <li><a asp-action="IndexReportAudit" asp-controller="ContractDetails"><i class="bi bi-clipboard-check"></i> متابعة التحصيل</a></li>
                        <li><a asp-action="IndexReportTakeMoney" asp-controller="EmployeeTakeMoneys"><i class="bi bi-wallet"></i> العهد</a></li>
@*                         <li><a asp-action="IndexPrint" asp-controller="CompanyDebits"><i class="bi bi-building-check"></i> ديون الشركات مجمع</a></li>
                        <li><a asp-action="Index" asp-controller="CompanyDebitDetails"><i class="bi bi-building-down"></i> ديون الشركات تفصيلي</a></li>
 *@                    </ul>    
                </li>

                <!-- طباعة -->
                <li class="nav-item has-dropdown">
                    <a href="#" class="nav-tab">
                        <i class="bi bi-printer"></i>
                        طباعة
                        <i class="bi bi-chevron-down arrow"></i>
                    </a>
                    <ul class="dropdown-menu-custom">
                        <li><a asp-controller="PermitGeneration" asp-action="Index"><i class="fas fa-taxi"></i> تصريح إجرة جوالة</a></li>
                        <li><a asp-controller="PermitGeneration" asp-action="IndexRenewal"><i class="fas fa-id-card"></i> تجديد رخصة سوق</a></li>
                        <li><a asp-controller="PermitGeneration" asp-action="CheckTemplate"><i class="bi bi-file-check"></i> فحص القوالب</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="container-fluid px-4 mt-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ===== FOOTER ===== -->
    <footer class="main-footer">
        <div class="container-fluid px-4">
            &copy; 2026 - شركة أجرة الزاجل  الدولي الجوال
        </div>
    </footer>

    <!-- Vendor JS Files -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/fontawesome-free/js/all.min.js"></script>

    <!-- Menu Script -->
    <script>
        // Mobile menu toggle
        function toggleMobileMenu() {
            var menu = document.getElementById('navMenu');
            menu.classList.toggle('show');
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.nav-item')) {
                document.querySelectorAll('.has-dropdown').forEach(function (item) {
                    item.classList.remove('open');
                });
            }
        });

        // Handle dropdown click on mobile
        document.querySelectorAll('.has-dropdown > .nav-tab').forEach(function (tab) {
            tab.addEventListener('click', function (e) {
                if (window.innerWidth < 1200) {
                    e.preventDefault();
                    var parent = this.parentElement;
                    // Close other open dropdowns
                    document.querySelectorAll('.has-dropdown').forEach(function (item) {
                        if (item !== parent) item.classList.remove('open');
                    });
                    parent.classList.toggle('open');
                }
            });
        });

        // Handle submenu click on mobile
        document.querySelectorAll('.has-submenu > a').forEach(function (link) {
            link.addEventListener('click', function (e) {
                if (window.innerWidth < 1200) {
                    e.preventDefault();
                    this.parentElement.classList.toggle('open');
                }
            });
        });
    </script>
</body>
</html>
