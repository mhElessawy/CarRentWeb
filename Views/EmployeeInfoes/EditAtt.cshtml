@model CarRentWeb.Models.EmployeeInfoAtt
@{
    ViewData["Title"] = "EditAtt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4" dir="rtl">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0" style="color:white">تعديل بيانات ملف</h4>
        </div>
        <div class="card-body">
            <form asp-action="EditAtt" class="row g-3" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="EmpId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Personal Information Section -->
                <div class="col-md-12">
                    <h5 class="border-bottom pb-2">بيانات الملف</h5>
                </div>

                <div class="col-md-3">
                    <label asp-for="TitleData" class="form-label">عنوان الملف</label>
                    <input asp-for="TitleData" class="form-control" type="text" required />
                    <span asp-validation-for="TitleData" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="pdfFile1" class="form-label">ملف جديد (PDF أو صورة)</label>
                    <input asp-for="pdfFile1" class="form-control" type="file"
                           accept=".pdf,application/pdf,.jpg,.jpeg,.png,.gif,.webp,image/*" />
                    <span asp-validation-for="pdfFile1" class="text-danger small"></span>
                    <small class="text-muted">اتركه فارغاً للإبقاء على الملف الحالي</small>
                </div>

                <input type="hidden" asp-for="PathFileData" />

                @if (Model != null && !string.IsNullOrEmpty(Model.PathFileData))
                {
                    var ext = System.IO.Path.GetExtension(Model.PathFileData).ToLower();
                    var isImage = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" }.Contains(ext);
                    <div class="col-md-12 mt-3">
                        <label class="form-label">الملف الحالي:</label>
                        <div class="d-flex align-items-center gap-3">
                            @if (isImage)
                            {
                                <img src="@Model.PathFileData" alt="مرفق" style="max-height:120px;max-width:200px;border-radius:6px;border:1px solid #dee2e6;" />
                            }
                            else
                            {
                                <i class="fas fa-file-pdf fa-2x text-danger"></i>
                            }
                            <a href="@Model.PathFileData" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-eye"></i> عرض الملف
                            </a>
                            <span class="text-muted small">@System.IO.Path.GetFileName(Model.PathFileData)</span>
                        </div>
                    </div>
                }

                <!-- Form Actions -->
                <div class="col-md-12 mt-4">
                    <div class="d-flex justify-content-between">
                        <a asp-action="IndexAtt" asp-route-id="@Model!.EmpId" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> العوده للصفحة الرئيسية
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> تعديل بيانات الملف
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .form-label {
        font-weight: 500;
    }

    h5 {
        color: #0d6efd;
    }
</style>