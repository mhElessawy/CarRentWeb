@using CarRentWeb.Models
@model CarRentWeb.Models.CompanyInfoAtt

@{
    ViewData["Title"] = "CreateAttatch";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var company = ViewBag.CompanyData as CompanyInfo;
}

@if (company != null)
{
    <div class="company-details" dir="rtl">
        <h3>بيانات الشركة</h3>
        <p><strong>الاسم :</strong> @company.CompNameAr</p>
        <p><strong>كود الشركة :</strong> @company.CompCode</p>
    </div>
}
else
{
    <p>Company not found.</p>
}

<div class="container mt-4" dir="rtl">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0" style="color:white">إضافة مرفق</h4>
        </div>
        <div class="card-body">
            <form asp-action="CreateAttatch" class="row g-3" dir="rtl" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" name="CompId" value="@ViewBag.CompId" />

                <div class="col-md-12 mt-3">
                    <h5 class="border-bottom pb-2">بيانات الملف</h5>
                </div>

                <div class="col-md-4">
                    <label asp-for="TitleData" class="form-label">عنوان الملف</label>
                    <input asp-for="TitleData" class="form-control" />
                    <span asp-validation-for="TitleData" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">الملف أو الصورة</label>
                    <input asp-for="pdfFile1" type="file" class="form-control"
                           accept=".pdf,application/pdf,image/jpeg,image/png,image/gif,image/webp" />
                    <span asp-validation-for="pdfFile1" class="text-danger small"></span>
                </div>

                <div class="col-md-12 mt-4">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Attatchment" asp-route-id="@ViewBag.CompId" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> العوده للصفحة الرئيسية
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> إضافة ملف
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .form-label {
        font-weight: 500;
    }

    h5 {
        color: #0d6efd;
    }
</style>