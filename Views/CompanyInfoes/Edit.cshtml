@model CarRentWeb.Models.CompanyInfo

@{
    ViewData["Title"] = "تعديل بيانات شركة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header" dir="rtl">
    <h2><i class="bi bi-building-gear"></i> تعديل بيانات شركة</h2>
</div>

<form asp-action="Edit" dir="rtl" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DeleteFlag" />

    <!-- ===== القسم 1: بيانات الشركة الأساسية ===== -->
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-building"></i> بيانات الشركة الأساسية</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CompCode" class="form-label">كود الشركة</label>
                <input asp-for="CompCode" class="form-control" required />
                <span asp-validation-for="CompCode" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CompNameAr" class="form-label">اسم الشركة بالعربي</label>
                <input asp-for="CompNameAr" class="form-control" required />
                <span asp-validation-for="CompNameAr" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CompNameEn" class="form-label">اسم الشركة بالإنجليزي</label>
                <input asp-for="CompNameEn" class="form-control" />
                <span asp-validation-for="CompNameEn" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">شعار الشركة</label>
                <label for="ImageFile1" class="logo-upload-btn">
                    <i class="bi bi-camera-fill"></i> تغيير الصورة
                </label>
                <input type="file" name="ImageFile1" id="ImageFile1" accept="image/*" style="display: none;" onchange="previewImage(event)" />
                <div class="mt-2">
                    @if (!string.IsNullOrEmpty(Model.CompLogo))
                    {
                        <img id="currentLogo" src="~/UploadCompLogo/@Model.CompLogo" style="max-width: 150px; max-height: 100px; border-radius: 6px; border: 1px solid #ddd;" />
                    }
                    <img id="previewImg" src="" alt="" style="max-width: 150px; max-height: 100px; display: none; border-radius: 6px; border: 1px solid #ddd;" />
                </div>
            </div>
        </div>
    </div>

    <!-- ===== القسم 2: بيانات الشركاء ===== -->
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-people-fill"></i> بيانات الشركاء</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="OwnerName1" class="form-label">اسم صاحب العمل</label>
                <input asp-for="OwnerName1" class="form-control" required />
                <span asp-validation-for="OwnerName1" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="OwnerCivilId1" class="form-label">الرقم المدني</label>
                <input asp-for="OwnerCivilId1" class="form-control" required />
                <span asp-validation-for="OwnerCivilId1" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="OwnerName2" class="form-label">اسم صاحب الشركة 2</label>
                <input asp-for="OwnerName2" class="form-control" />
                <span asp-validation-for="OwnerName2" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="OwnerCivilId2" class="form-label">الرقم المدني 2</label>
                <input asp-for="OwnerCivilId2" class="form-control" />
                <span asp-validation-for="OwnerCivilId2" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="OwnerName3" class="form-label">اسم صاحب الشركة 3</label>
                <input asp-for="OwnerName3" class="form-control" />
                <span asp-validation-for="OwnerName3" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="OwnerCivilId3" class="form-label">الرقم المدني 3</label>
                <input asp-for="OwnerCivilId3" class="form-control" />
                <span asp-validation-for="OwnerCivilId3" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- ===== القسم 3: بيانات عقد الإيجار ===== -->
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-house-door-fill"></i> بيانات عقد الإيجار</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="OwnerHome" class="form-label">صاحب العقار</label>
                <input asp-for="OwnerHome" class="form-control" />
                <span asp-validation-for="OwnerHome" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="RentContractNo" class="form-label">رقم عقد الإيجار</label>
                <input asp-for="RentContractNo" class="form-control" />
                <span asp-validation-for="RentContractNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressLocation" class="form-label">المنطقة</label>
                <input asp-for="AddressLocation" class="form-control" />
                <span asp-validation-for="AddressLocation" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressArea" class="form-label">القطعة</label>
                <input asp-for="AddressArea" class="form-control" />
                <span asp-validation-for="AddressArea" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressQasima" class="form-label">القسيمة</label>
                <input asp-for="AddressQasima" class="form-control" />
                <span asp-validation-for="AddressQasima" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressLevel" class="form-label">الدور</label>
                <input asp-for="AddressLevel" class="form-control" />
                <span asp-validation-for="AddressLevel" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressType" class="form-label">نوع المبنى</label>
                <input asp-for="AddressType" class="form-control" />
                <span asp-validation-for="AddressType" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressTypeNo" class="form-label">رقم المبني</label>
                <input asp-for="AddressTypeNo" class="form-control" />
                <span asp-validation-for="AddressTypeNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressStreet" class="form-label">الشارع</label>
                <input asp-for="AddressStreet" class="form-control" />
                <span asp-validation-for="AddressStreet" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressBuildingName" class="form-label">اسم المبنى</label>
                <input asp-for="AddressBuildingName" class="form-control" />
                <span asp-validation-for="AddressBuildingName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressUnitNo" class="form-label">رقم الوحدة</label>
                <input asp-for="AddressUnitNo" class="form-control" />
                <span asp-validation-for="AddressUnitNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressAutoNo" class="form-label">الرقم الآلي للعنوان</label>
                <input asp-for="AddressAutoNo" class="form-control" />
                <span asp-validation-for="AddressAutoNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AddressRent" class="form-label">الإيجار</label>
                <input asp-for="AddressRent" class="form-control" />
                <span asp-validation-for="AddressRent" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="StartRent" class="form-label">بداية الإيجار</label>
                <input asp-for="StartRent" type="date" class="form-control" />
                <span asp-validation-for="StartRent" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="EndRent" class="form-label">نهاية الإيجار</label>
                <input asp-for="EndRent" type="date" class="form-control" />
                <span asp-validation-for="EndRent" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- ===== القسم 4: بيانات المعلومات المدنية ===== -->
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-card-heading"></i> بيانات المعلومات المدنية</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="CivilInfoDate" class="form-label">تاريخ المعلومات المدنية</label>
                <input asp-for="CivilInfoDate" type="date" class="form-control" />
                <span asp-validation-for="CivilInfoDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CivilInfoRef" class="form-label">المرجع</label>
                <input asp-for="CivilInfoRef" class="form-control" />
                <span asp-validation-for="CivilInfoRef" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CivilSignboardName" class="form-label">اسم اللافتة</label>
                <input asp-for="CivilSignboardName" class="form-control" />
                <span asp-validation-for="CivilSignboardName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CivilLicenseName" class="form-label">اسم الرخصة</label>
                <input asp-for="CivilLicenseName" class="form-control" />
                <span asp-validation-for="CivilLicenseName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CivilLicenseHolder" class="form-label">اسم الحائز</label>
                <input asp-for="CivilLicenseHolder" class="form-control" />
                <span asp-validation-for="CivilLicenseHolder" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CivilLatinName" class="form-label">الاسم اللاتيني</label>
                <input asp-for="CivilLatinName" class="form-control" />
                <span asp-validation-for="CivilLatinName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CivilID" class="form-label">الرقم المدني للجهة</label>
                <input asp-for="CivilID" class="form-control" />
                <span asp-validation-for="CivilID" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CivilEconomicActivity" class="form-label">النشاط الاقتصادي</label>
                <input asp-for="CivilEconomicActivity" class="form-control" />
                <span asp-validation-for="CivilEconomicActivity" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CivilLicenseAuthority" class="form-label">جهة الترخيص</label>
                <input asp-for="CivilLicenseAuthority" class="form-control" />
                <span asp-validation-for="CivilLicenseAuthority" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CompFileNo" class="form-label">رقم ملف جهة الترخيص</label>
                <input asp-for="CompFileNo" class="form-control" />
                <span asp-validation-for="CompFileNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CompLicenseNo" class="form-label">رقم الرخصة</label>
                <input asp-for="CompLicenseNo" class="form-control" />
                <span asp-validation-for="CompLicenseNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CompActivateId" class="form-label">نوع النشاط</label>
                <select asp-for="CompActivateId" class="form-control" asp-items="ViewBag.CompActivateId">
                    <option value="">-- اختر --</option>
                </select>
                <span asp-validation-for="CompActivateId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- ===== القسم 5: رخصة تجارية + مستخرج السجل التجاري ===== -->
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-file-earmark-text-fill"></i> رخصة تجارية + مستخرج السجل التجاري</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="TradeLicenseNo" class="form-label">رقم الترخيص</label>
                <input asp-for="TradeLicenseNo" class="form-control" />
                <span asp-validation-for="TradeLicenseNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CenterNo" class="form-label">الرقم المركزي</label>
                <input asp-for="CenterNo" class="form-control" />
                <span asp-validation-for="CenterNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CommercialRegistrationNo" class="form-label">رقم السجل التجاري</label>
                <input asp-for="CommercialRegistrationNo" class="form-control" />
                <span asp-validation-for="CommercialRegistrationNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="LegalEntity" class="form-label">الكيان القانوني</label>
                <input asp-for="LegalEntity" class="form-control" />
                <span asp-validation-for="LegalEntity" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="TradeName" class="form-label">الاسم التجاري</label>
                <input asp-for="TradeName" class="form-control" />
                <span asp-validation-for="TradeName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Capital" class="form-label">رأس المال</label>
                <input asp-for="Capital" class="form-control" />
                <span asp-validation-for="Capital" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="RegistrationDate" class="form-label">تاريخ القيد في السجل</label>
                <input asp-for="RegistrationDate" type="date" class="form-control" />
                <span asp-validation-for="RegistrationDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ActivityCode" class="form-label">رمز النشاط</label>
                <input asp-for="ActivityCode" class="form-control" />
                <span asp-validation-for="ActivityCode" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CompanyStatus" class="form-label">حالة الشركة</label>
                <input asp-for="CompanyStatus" class="form-control" />
                <span asp-validation-for="CompanyStatus" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MainLicenseStatus" class="form-label">حالة الترخيص الرئيسي</label>
                <input asp-for="MainLicenseStatus" class="form-control" />
                <span asp-validation-for="MainLicenseStatus" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="LicenseType" class="form-label">نوع الترخيص</label>
                <input asp-for="LicenseType" class="form-control" />
                <span asp-validation-for="LicenseType" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="PartnersCount" class="form-label">عدد الشركاء</label>
                <input asp-for="PartnersCount" class="form-control" />
                <span asp-validation-for="PartnersCount" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ActivitiesCount" class="form-label">عدد الأنشطة</label>
                <input asp-for="ActivitiesCount" class="form-control" />
                <span asp-validation-for="ActivitiesCount" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ManagersCount" class="form-label">عدد المديرين</label>
                <input asp-for="ManagersCount" class="form-control" />
                <span asp-validation-for="ManagersCount" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="FiscalYearStartMonth" class="form-label">بداية السنة المالية (شهر)</label>
                <input asp-for="FiscalYearStartMonth" class="form-control" min="1" max="12" />
                <span asp-validation-for="FiscalYearStartMonth" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="FiscalYearEndMonth" class="form-label">نهاية السنة المالية (شهر)</label>
                <input asp-for="FiscalYearEndMonth" class="form-control" min="1" max="12" />
                <span asp-validation-for="FiscalYearEndMonth" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="StartLicense" class="form-label">تاريخ بداية الترخيص</label>
                <input asp-for="StartLicense" type="date" class="form-control" />
                <span asp-validation-for="StartLicense" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="EndLicense" class="form-label">تاريخ نهاية الترخيص</label>
                <input asp-for="EndLicense" type="date" class="form-control" />
                <span asp-validation-for="EndLicense" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="ManagerPermissions" class="form-label">صلاحيات المدير</label>
                <textarea asp-for="ManagerPermissions" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ManagerPermissions" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- ===== القسم 6: شهادة سداد التأمينات ===== -->
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-shield-check"></i> شهادة سداد التأمينات</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="InsuranceRegNo" class="form-label">رقم التسجيل</label>
                <input asp-for="InsuranceRegNo" class="form-control" />
                <span asp-validation-for="InsuranceRegNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="InsuranceSector" class="form-label">القطاع</label>
                <input asp-for="InsuranceSector" class="form-control" />
                <span asp-validation-for="InsuranceSector" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="InsuranceRef" class="form-label">مرجع الشهادة</label>
                <input asp-for="InsuranceRef" class="form-control" />
                <span asp-validation-for="InsuranceRef" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="InsuranceCertDate" class="form-label">تاريخ الشهادة</label>
                <input asp-for="InsuranceCertDate" type="date" class="form-control" />
                <span asp-validation-for="InsuranceCertDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="InsuranceCertValidDate" class="form-label">صلاحية الشهادة</label>
                <input asp-for="InsuranceCertValidDate" type="date" class="form-control" />
                <span asp-validation-for="InsuranceCertValidDate" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- ===== القسم 7: اعتماد توقيع - القوى العاملة ===== -->
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-person-badge-fill"></i> اعتماد توقيع - القوى العاملة</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="ManpowerFileNo" class="form-label">رقم الملف</label>
                <input asp-for="ManpowerFileNo" class="form-control" />
                <span asp-validation-for="ManpowerFileNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ManpowerFileType" class="form-label">نوع الملف</label>
                <input asp-for="ManpowerFileType" class="form-control" />
                <span asp-validation-for="ManpowerFileType" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ManpowerFileClassification" class="form-label">تصنيف الملف</label>
                <input asp-for="ManpowerFileClassification" class="form-control" />
                <span asp-validation-for="ManpowerFileClassification" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ManpowerWorkAdmin" class="form-label">إدارة العمل</label>
                <input asp-for="ManpowerWorkAdmin" class="form-control" />
                <span asp-validation-for="ManpowerWorkAdmin" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="UnifiedNo" class="form-label">الرقم الموحد</label>
                <input asp-for="UnifiedNo" class="form-control" />
                <span asp-validation-for="UnifiedNo" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="GovContractsCount" class="form-label">اجمالي العقود الحكومية</label>
                <input asp-for="GovContractsCount" class="form-control" />
                <span asp-validation-for="GovContractsCount" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AuthorizedPersonName" class="form-label">اسم المفوض</label>
                <input asp-for="AuthorizedPersonName" class="form-control" />
                <span asp-validation-for="AuthorizedPersonName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AuthorizedPersonCivilId" class="form-label">الرقم المدني للمفوض</label>
                <input asp-for="AuthorizedPersonCivilId" class="form-control" />
                <span asp-validation-for="AuthorizedPersonCivilId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="AuthorizationDate" class="form-label">تاريخ التفويض</label>
                <input asp-for="AuthorizationDate" type="date" class="form-control" />
                <span asp-validation-for="AuthorizationDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ManpowerCertIssueDate" class="form-label">تاريخ إصدار الشهادة</label>
                <input asp-for="ManpowerCertIssueDate" type="date" class="form-control" />
                <span asp-validation-for="ManpowerCertIssueDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ManpowerCertExpiryDate" class="form-label">تاريخ انتهاء الشهادة</label>
                <input asp-for="ManpowerCertExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="ManpowerCertExpiryDate" class="text-danger"></span>
            </div>

            <!-- صورة توقيع الاعتماد -->
            <div class="col-md-12">
                <label class="form-label fw-bold">صورة توقيع الاعتماد</label>
                <div class="signature-upload-box">
                    <input type="hidden" asp-for="CompSignature" />
                    <label for="SignatureFile" class="signature-upload-btn">
                        <i class="bi bi-pencil-square"></i> رفع صورة التوقيع
                    </label>
                    <input type="file" name="SignatureFile" id="SignatureFile" accept="image/*"
                           style="display:none;" onchange="previewSignature(event)" />
                    <div class="mt-3">
                        @if (!string.IsNullOrEmpty(Model.CompSignature))
                        {
                            <div id="currentSignatureContainer">
                                <p class="text-muted small mb-1">التوقيع الحالي:</p>
                                <img id="currentSignature" src="~/UploadCompSignature/@Model.CompSignature"
                                     style="max-width:300px; max-height:150px; border:1px solid #ddd; border-radius:6px; padding:6px; background:#fff;" />
                            </div>
                        }
                        <img id="previewSignatureImg" src="" alt=""
                             style="max-width:300px; max-height:150px; display:none; border:1px solid #ddd; border-radius:6px; padding:6px; background:#fff;" />
                        <div id="signatureFileName" class="text-success small mt-1" style="display:none;"></div>
                    </div>
                    <span asp-validation-for="CompSignature" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== القسم 8: بيانات التواصل ===== -->
    <div class="form-section">
        <div class="form-section-title"><i class="bi bi-telephone-fill"></i> بيانات التواصل</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="LocationId" class="form-label">المحافظة</label>
                <select asp-for="LocationId" class="form-control" asp-items="ViewBag.LocationId">
                    <option value="">-- اختر --</option>
                </select>
                <span asp-validation-for="LocationId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CityId" class="form-label">المدينة</label>
                <select asp-for="CityId" class="form-control" asp-items="ViewBag.CityId">
                    <option value="">-- اختر --</option>
                </select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Tel1" class="form-label">رقم الهاتف 1</label>
                <input asp-for="Tel1" class="form-control" />
                <span asp-validation-for="Tel1" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Tel2" class="form-label">رقم الهاتف 2</label>
                <input asp-for="Tel2" class="form-control" />
                <span asp-validation-for="Tel2" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CompReleaseDate" class="form-label">تاريخ الاصدار</label>
                <input asp-for="CompReleaseDate" type="date" class="form-control" />
                <span asp-validation-for="CompReleaseDate" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- ===== أزرار الحفظ والإلغاء ===== -->
    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-check-circle"></i> حفظ التعديلات
        </button>
        <a asp-action="Index" class="btn btn-secondary btn-lg">
            <i class="bi bi-x-circle"></i> إلغاء
        </a>
    </div>
</form>

<script>
    function previewImage(event) {
        const reader = new FileReader();
        reader.onload = function () {
            const previewImg = document.getElementById('previewImg');
            previewImg.src = reader.result;
            previewImg.style.display = 'block';
            var currentLogo = document.getElementById('currentLogo');
            if (currentLogo) currentLogo.style.display = 'none';
        }
        reader.readAsDataURL(event.target.files[0]);
    }

    function previewSignature(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function () {
            const previewImg = document.getElementById('previewSignatureImg');
            previewImg.src = reader.result;
            previewImg.style.display = 'block';

            const currentContainer = document.getElementById('currentSignatureContainer');
            if (currentContainer) currentContainer.style.display = 'none';

            const nameDiv = document.getElementById('signatureFileName');
            nameDiv.textContent = 'تم اختيار: ' + file.name;
            nameDiv.style.display = 'block';
        }
        reader.readAsDataURL(file);
    }
</script>

