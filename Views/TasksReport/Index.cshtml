@model List<UnifiedTaskReportItem>

@{
    ViewData["Title"] = "التقرير الشامل للمهام";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = (DateOnly)ViewBag.Today;
    var taskType = ViewBag.TaskType as string ?? "";
    var status = ViewBag.Status as string ?? "";
    var search = ViewBag.Search as string ?? "";
    var dateFrom = ViewBag.DateFrom as string ?? "";
    var dateTo = ViewBag.DateTo as string ?? "";

    int totalCount = Model.Count;
    int completedCount = Model.Count(x => x.IsCompleted);
    int overdueCount = Model.Count(x => !x.IsCompleted && x.DelayDays.HasValue && x.DelayDays > 0);
    int pendingCount = Model.Count(x => !x.IsCompleted);
    int noTargetCount = Model.Count(x => !x.TargetDate.HasValue && !x.IsCompleted);
    int foundationCount = Model.Count(x => x.TaskType == "Foundation");
    int periodicCount = Model.Count(x => x.TaskType == "Periodic");
    int adminCount = Model.Count(x => x.TaskType == "Admin");
}

<style>
    .page-header {
        background: linear-gradient(135deg, #343a40, #1a1d20);
        color: white;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }

    .report-table th {
        background: #f8f9fa;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .report-table td {
        vertical-align: middle;
        font-size: 0.88rem;
    }

    .stat-card {
        border-radius: 10px;
        padding: 12px 16px;
        color: white;
        text-align: center;
    }

    .row-overdue {
        background: #fff5f5 !important;
    }

    .row-completed {
        background: #f0fff4 !important;
        opacity: .85;
    }

    .row-no-target {
        background: #fffdf0 !important;
    }

    .type-badge {
        font-size: 0.76rem;
        padding: 2px 8px;
        border-radius: 5px;
        font-weight: 600;
    }

    .delay-badge {
        font-size: 0.78rem;
        padding: 3px 8px;
        border-radius: 5px;
    }

    .summary-row td {
        background: #f1f3f5 !important;
        font-weight: 600;
    }

    @@media print {
        body {
            direction: rtl;
            font-family: Arial, sans-serif;
            font-size: 11px;
        }

        .no-print {
            display: none !important;
        }

        .print-header {
            display: block !important;
            text-align: center;
            margin-bottom: 14px;
            border-bottom: 2px solid #333;
            padding-bottom: 8px;
        }

            .print-header h4 {
                margin: 0 0 4px;
                font-size: 16px;
            }

            .print-header p {
                margin: 0;
                font-size: 11px;
                color: #555;
            }

        .stat-card {
            border: 1px solid #ccc !important;
            color: #000 !important;
            background: #f5f5f5 !important;
            -webkit-print-color-adjust: exact;
        }

        .report-table th {
            background: #eee !important;
            -webkit-print-color-adjust: exact;
        }

        .report-table td, .report-table th {
            border: 1px solid #ccc !important;
            padding: 4px 6px !important;
        }

        .row-overdue {
            background: #ffe0e0 !important;
            -webkit-print-color-adjust: exact;
        }

        .row-completed {
            background: #e0ffe8 !important;
            -webkit-print-color-adjust: exact;
        }
    }

    .print-header {
        display: none;
    }
</style>

<div class="container-fluid mt-3" dir="rtl">

    <div class="print-header">
        <h4>التقرير الشامل لمهام المندوب</h4>
        <p>تاريخ الطباعة: @today.ToString("yyyy/MM/dd") &nbsp;|&nbsp; إجمالي المهام: @totalCount</p>
    </div>

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 no-print">
        <div>
            <h5 class="mb-0"><i class="bi bi-clipboard2-pulse-fill me-2"></i>التقرير الشامل لمهام المندوب</h5>
            <small class="opacity-75">جميع المهام (تأسيسية + دورية + إدارية) بمواعيد التنفيذ والتأخير</small>
        </div>
        <button class="btn btn-light btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> طباعة
        </button>
    </div>

    <!-- Stats Row 1: Status -->
    <div class="row g-3 mb-2 no-print">
        <div class="col-6 col-md-3">
            <div class="stat-card bg-secondary">
                <div class="fs-4 fw-bold">@totalCount</div>
                <div class="small opacity-75">إجمالي المهام</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card bg-danger">
                <div class="fs-4 fw-bold">@overdueCount</div>
                <div class="small opacity-75">متأخرة</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card bg-warning text-dark">
                <div class="fs-4 fw-bold">@pendingCount</div>
                <div class="small">غير مكتملة</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card bg-success">
                <div class="fs-4 fw-bold">@completedCount</div>
                <div class="small opacity-75">مكتملة</div>
            </div>
        </div>
    </div>

    <!-- Stats Row 2: By Type -->
    <div class="row g-3 mb-3 no-print">
        <div class="col-4">
            <div class="stat-card" style="background:#0d6efd">
                <div class="fs-5 fw-bold">@foundationCount</div>
                <div class="small opacity-75"><i class="bi bi-person-check-fill me-1"></i>تأسيسية</div>
            </div>
        </div>
        <div class="col-4">
            <div class="stat-card" style="background:#198754">
                <div class="fs-5 fw-bold">@periodicCount</div>
                <div class="small opacity-75"><i class="bi bi-arrow-repeat me-1"></i>دورية</div>
            </div>
        </div>
        <div class="col-4">
            <div class="stat-card" style="background:#6f42c1">
                <div class="fs-5 fw-bold">@adminCount</div>
                <div class="small opacity-75"><i class="bi bi-briefcase-fill me-1"></i>إدارية</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" class="card p-3 mb-3 shadow-sm no-print" style="border-radius:10px">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">نوع المهمة</label>
                <select name="taskType" class="form-select form-select-sm" dir="rtl">
                    <option value="" selected="@(taskType == "")">-- الكل --</option>
                    <option value="Foundation" selected="@(taskType == "Foundation")">تأسيسية</option>
                    <option value="Periodic" selected="@(taskType == "Periodic")">دورية</option>
                    <option value="Admin" selected="@(taskType == "Admin")">إدارية</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">الحالة</label>
                <select name="status" class="form-select form-select-sm" dir="rtl">
                    <option value="" selected="@(status == "")">-- الكل --</option>
                    <option value="overdue" selected="@(status == "overdue")">متأخرة</option>
                    <option value="pending" selected="@(status == "pending")">غير مكتملة</option>
                    <option value="completed" selected="@(status == "completed")">مكتملة</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">بحث بالاسم / المهمة</label>
                <input type="text" name="search" class="form-control form-control-sm"
                       placeholder="ابحث..." value="@search" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">من تاريخ</label>
                <input type="date" name="dateFrom" class="form-control form-control-sm" value="@dateFrom" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">إلى تاريخ</label>
                <input type="date" name="dateTo" class="form-control form-control-sm" value="@dateTo" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-dark btn-sm flex-fill"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="مسح"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-clipboard2-x fs-1 d-block mb-2"></i>
            <div class="fw-semibold">لا توجد مهام مطابقة</div>
            <div class="small">جرّب تغيير الفلتر</div>
        </div>
    }
    else
    {
        <div class="card shadow-sm" style="border-radius:10px;overflow:hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 report-table">
                    <thead>
                        <tr>
                            <th class="px-3">#</th>
                            <th>نوع المهمة</th>
                            <th>المهمة</th>
                            <th>المرتبط / المسؤول</th>
                            <th>موعد التنفيذ</th>
                            <th>تاريخ الإتمام</th>
                            <th>التأخير / المتبقي</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowNum = 0;
                        }
                        @foreach (var item in Model)
                        {
                            rowNum++;
                            bool isOverdue = !item.IsCompleted && item.DelayDays.HasValue && item.DelayDays > 0;
                            bool isNoTarget = !item.TargetDate.HasValue && !item.IsCompleted;
                            bool isToday = !item.IsCompleted && item.DelayDays.HasValue && item.DelayDays == 0;
                            string rowCls = item.IsCompleted ? "row-completed" : isOverdue ? "row-overdue" : isNoTarget ? "row-no-target" : "";

                            <tr class="@rowCls">
                                <td class="px-3 text-muted small">@rowNum</td>
                                <td>
                                    @if (item.TaskType == "Foundation")
                                    {
                                        <span class="type-badge bg-primary text-white"><i class="bi bi-person-check-fill me-1"></i>تأسيسية</span>
                                    }
                                    else if (item.TaskType == "Periodic")
                                    {
                                        <span class="type-badge bg-success text-white"><i class="bi bi-arrow-repeat me-1"></i>دورية</span>
                                    }
                                    else
                                    {
                                        <span class="type-badge text-white" style="background:#6f42c1"><i class="bi bi-briefcase-fill me-1"></i>إدارية</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold @(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                        @item.TaskName
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    @if (!string.IsNullOrEmpty(item.EntityName))
                                    {
                                        <span>@item.EntityName</span>
                                    }
                                    else
                                    {

                                        <span>—</span>
                                    }
                                </td>
                                <td class="@(isOverdue ? "text-danger fw-semibold" : isToday ? "text-warning fw-semibold" : "small")">
                                    @if (item.TargetDate.HasValue)
                                    {
                                        @item.TargetDate.Value.ToString("yyyy/MM/dd")
                                        @if (isToday)
                                        {
                                            <span class="badge bg-warning text-dark ms-1 small">اليوم</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small text-success">
                                    @if (item.CompletedDate.HasValue)
                                    {
                                        @item.CompletedDate.Value.ToString("yyyy/MM/dd")
                                    }
                                    else
                                    {

                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.TargetDate.HasValue)
                                    {
                                        <span class="delay-badge bg-light text-muted border">لم يُحدد موعد</span>
                                    }
                                    else if (item.IsCompleted)
                                    {
                                        <span class="delay-badge bg-success text-white"><i class="bi bi-check2 me-1"></i>منتهية</span>
                                    }
                                    else if (item.DelayDays!.Value > 0)
                                    {
                                        <span class="delay-badge bg-danger text-white">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>تأخر @item.DelayDays يوم
                                        </span>
                                    }
                                    else if (item.DelayDays.Value == 0)
                                    {
                                        <span class="delay-badge bg-warning text-dark"><i class="bi bi-clock-fill me-1"></i>اليوم</span>
                                    }
                                    else
                                    {
                                        int left = -item.DelayDays.Value;
                                        <span class="delay-badge @(left <= 3 ? "bg-warning text-dark" : left <= 7 ? "bg-info text-dark" : "bg-light text-dark border")">
                                            @left يوم متبقي
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsCompleted)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>مكتملة</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-exclamation-circle me-1"></i>متأخرة</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-hourglass me-1"></i>قيد التنفيذ</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="summary-row">
                        <tr>
                            <td colspan="2" class="px-3">الإجمالي</td>
                            <td colspan="4">@totalCount مهمة: @overdueCount متأخرة، @pendingCount غير مكتملة، @completedCount مكتملة</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>