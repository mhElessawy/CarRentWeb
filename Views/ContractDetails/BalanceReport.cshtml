@model CarRentWeb.Models.MyModel.BalanceReportViewModel

@{
    ViewData["Title"] = "تقرير الرصيد الحالي";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .report-header {
        text-align: right;
        margin-bottom: 10px;
    }

        .report-header h1 {
            color: #1a1a2e;
            font-weight: 800;
            font-size: 1.8rem;
            margin-bottom: 4px;
            border-bottom: 3px solid #3498db;
            display: inline-block;
            padding-bottom: 4px;
        }

    .report-date {
        color: #555;
        font-size: 0.85rem;
        text-align: right;
        margin-bottom: 15px;
    }

    /* Summary Cards */
    .summary-cards {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .summary-card {
        flex: 1;
        min-width: 200px;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        padding: 18px 24px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

        .summary-card .card-label {
            font-size: 0.85rem;
            color: #777;
            margin-bottom: 8px;
        }

        .summary-card .card-value {
            font-size: 1.6rem;
            font-weight: 700;
        }

    .card-value.rental {
        color: #e74c3c;
    }

    .card-value.debt {
        color: #e67e22;
    }

    .card-value.total {
        color: #1a1a2e;
    }

    /* Filter Bar */
    .filter-bar {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px 18px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
        direction: rtl;
    }

        .filter-bar label {
            font-weight: 600;
            color: #333;
            font-size: 0.85rem;
            white-space: nowrap;
        }

        .filter-bar input[type="text"],
        .filter-bar input[type="number"],
        .filter-bar select {
            padding: 6px 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 0.85rem;
            width: 130px;
        }

        .filter-bar select {
            width: 160px;
        }

    .btn-search {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 7px 18px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background-color: #2980b9;
        }

    .btn-reset {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 7px 18px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s;
    }

        .btn-reset:hover {
            background-color: #5a6268;
            color: white;
        }

    /* Table */
    .report-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
    }

        .report-table thead tr {
            background-color: #1a1a2e;
            color: #fff;
            text-align: center;
        }

        .report-table th,
        .report-table td {
            padding: 9px 10px;
            border-bottom: 1px solid #e0e0e0;
            text-align: center;
            white-space: nowrap;
        }

        .report-table tbody tr:nth-of-type(even) {
            background-color: #f8f9fa;
        }

        .report-table tbody tr:hover {
            background-color: #eaf4fb;
        }

    .col-rental {
        color: #e74c3c;
        font-weight: 600;
    }

    .col-debt {
        color: #e67e22;
        font-weight: 600;
    }

    .col-total {
        font-weight: 700;
        color: #1a1a2e;
    }

    .totals-row {
        background-color: #f0f4f8 !important;
        font-weight: 700;
        border-top: 2px solid #1a1a2e;
    }

    .btn-print {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 9px 22px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 600;
        margin-top: 14px;
        transition: background 0.2s;
    }

        .btn-print:hover {
            background-color: #218838;
        }

    @@media print {
        .filter-bar, .btn-print, .report-header {
            display: none !important;
        }
    }
</style>

<div dir="rtl">
    <div class="report-header">
        <h1>تقرير الرصيد الحالي</h1>
    </div>
    <div class="report-date">التاريخ: @DateTime.Today.ToString("yyyy/MM/dd")</div>

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="summary-card">
            <div class="card-label">إجمالي المبالغ المتأخرة</div>
            <div class="card-value rental">@Model.TotalOverdueRental.ToString("N2")</div>
        </div>
        <div class="summary-card">
            <div class="card-label">إجمالي الديون المتبقية</div>
            <div class="card-value debt">@Model.TotalRemainingDebt.ToString("N2")</div>
        </div>
        <div class="summary-card">
            <div class="card-label">الإجمالي الكلي</div>
            <div class="card-value total">@Model.GrandTotal.ToString("N2")</div>
        </div>
    </div>

    <!-- Filter Bar -->
    <form asp-action="BalanceReport" method="get">
        <div class="filter-bar">
            <label>رقم الموظف:</label>
            <input type="number" name="EmpCodeString" value="@Context.Request.Query["EmpCodeString"]" placeholder="رقم الموظف" />

            <label>اسم الموظف:</label>
            <input type="text" name="EmpSearch" value="@Context.Request.Query["EmpSearch"]" placeholder="اسم الموظف" />

            <label>الشركة:</label>
            <select name="companyId" asp-items="ViewBag.Companies">
                <option value="">-- جميع الشركات --</option>
            </select>

            <button type="submit" class="btn-search">بحث</button>
            <a asp-action="BalanceReport" class="btn-reset">إعادة تعيين</a>
        </div>
    </form>

    <!-- Data Table -->
    <table class="report-table">
        <thead>
            <tr>
                <th>#</th>
                <th>كود الموظف</th>
                <th>اسم الموظف</th>
                <th>رقم الهاتف</th>
                <th>الشركة</th>
                <th>المبالغ المتأخرة</th>
                <th>الديون المتبقية</th>
                <th>الإجمالي</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                int rowNum = 1;
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@(rowNum++)</td>
                        <td>@item.EmpCode</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.MobileNo</td>
                        <td>@item.CompanyName</td>
                        <td class="col-rental">@item.OverdueRental.ToString("N2")</td>
                        <td class="col-debt">@item.RemainingDebt.ToString("N2")</td>
                        <td class="col-total">@((item.OverdueRental + item.RemainingDebt).ToString("N2"))</td>
                    </tr>
                }
                <tr class="totals-row">
                    <td colspan="5" style="text-align:right; padding-right:12px;">المجموع</td>
                    <td class="col-rental">@Model.TotalOverdueRental.ToString("N2")</td>
                    <td class="col-debt">@Model.TotalRemainingDebt.ToString("N2")</td>
                    <td class="col-total">@Model.GrandTotal.ToString("N2")</td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="8" style="text-align:center; padding:20px; color:#999;">
                        لا توجد بيانات
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button onclick="printReport()" class="btn-print">طباعة</button>
</div>

<!-- قسم الطباعة المخفي -->
<div id="print-section" style="display:none">
    <div dir="rtl" style="font-family:'Arial',sans-serif; padding:24px; color:#000;">

        <!-- رأس التقرير -->
        <div style="text-align:center; border-bottom:3px solid #1a1a2e; padding-bottom:10px; margin-bottom:14px;">
            <h2 style="margin:0; font-size:1.3rem; color:#1a1a2e; letter-spacing:1px;">تقرير الرصيد الحالي</h2>
            <p style="margin:4px 0 0; font-size:0.82rem; color:#555;">تاريخ الطباعة: @DateTime.Today.ToString("dd/MM/yyyy")</p>
        </div>

        <!-- بطاقات الملخص -->
        <div style="display:flex; gap:12px; margin-bottom:16px; direction:rtl;">
            <div style="flex:1; border:1px solid #e0e0e0; border-radius:6px; padding:10px 14px; text-align:center;">
                <div style="font-size:0.75rem; color:#777; margin-bottom:4px;">إجمالي المبالغ المتأخرة</div>
                <div style="font-size:1.1rem; font-weight:700; color:#e74c3c;">@Model.TotalOverdueRental.ToString("N3")</div>
            </div>
            <div style="flex:1; border:1px solid #e0e0e0; border-radius:6px; padding:10px 14px; text-align:center;">
                <div style="font-size:0.75rem; color:#777; margin-bottom:4px;">إجمالي الديون المتبقية</div>
                <div style="font-size:1.1rem; font-weight:700; color:#e67e22;">@Model.TotalRemainingDebt.ToString("N3")</div>
            </div>
            <div style="flex:1; border:1px solid #e0e0e0; border-radius:6px; padding:10px 14px; text-align:center;">
                <div style="font-size:0.75rem; color:#777; margin-bottom:4px;">الإجمالي الكلي</div>
                <div style="font-size:1.1rem; font-weight:700; color:#1a1a2e;">@Model.GrandTotal.ToString("N3")</div>
            </div>
        </div>

        <!-- الجدول -->
        <table style="width:100%; border-collapse:collapse; font-size:0.8rem; direction:rtl;">
            <thead>
                <tr style="background:#1a1a2e; color:#fff;">
                    <th style="border:1px solid #444; padding:7px 10px; text-align:center;">#</th>
                    <th style="border:1px solid #444; padding:7px 10px; text-align:center;">كود الموظف</th>
                    <th style="border:1px solid #444; padding:7px 10px; text-align:right;">اسم الموظف</th>
                    <th style="border:1px solid #444; padding:7px 10px; text-align:center;">رقم الهاتف</th>
                    <th style="border:1px solid #444; padding:7px 10px; text-align:center;">الشركة</th>
                    <th style="border:1px solid #444; padding:7px 10px; text-align:center;">المبالغ المتأخرة</th>
                    <th style="border:1px solid #444; padding:7px 10px; text-align:center;">الديون المتبقية</th>
                    <th style="border:1px solid #444; padding:7px 10px; text-align:center;">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @{int rn = 1;}
                @foreach (var item in Model.Items)
                {
                    var bg = (rn % 2 == 0) ? "#f8f9fa" : "#fff";
                    <tr style="background:@bg;">
                        <td style="border:1px solid #ddd; padding:5px 10px; text-align:center;">@(rn++)</td>
                        <td style="border:1px solid #ddd; padding:5px 10px; text-align:center;">@item.EmpCode</td>
                        <td style="border:1px solid #ddd; padding:5px 10px; text-align:right;">@item.EmployeeName</td>
                        <td style="border:1px solid #ddd; padding:5px 10px; text-align:center;">@item.MobileNo</td>
                        <td style="border:1px solid #ddd; padding:5px 10px; text-align:center;">@item.CompanyName</td>
                        <td style="border:1px solid #ddd; padding:5px 10px; text-align:center; color:#e74c3c; font-weight:600;">@item.OverdueRental.ToString("N3")</td>
                        <td style="border:1px solid #ddd; padding:5px 10px; text-align:center; color:#e67e22; font-weight:600;">@item.RemainingDebt.ToString("N3")</td>
                        <td style="border:1px solid #ddd; padding:5px 10px; text-align:center; font-weight:700;">@((item.OverdueRental + item.RemainingDebt).ToString("N3"))</td>
                    </tr>
                }
                <!-- صف الإجمالي -->
                <tr style="background:#f0f4f8; font-weight:700; border-top:2px solid #1a1a2e;">
                    <td colspan="5" style="border:1px solid #bbb; padding:6px 10px; text-align:right;">الإجمالي</td>
                    <td style="border:1px solid #bbb; padding:6px 10px; text-align:center; color:#e74c3c;">@Model.TotalOverdueRental.ToString("N3")</td>
                    <td style="border:1px solid #bbb; padding:6px 10px; text-align:center; color:#e67e22;">@Model.TotalRemainingDebt.ToString("N3")</td>
                    <td style="border:1px solid #bbb; padding:6px 10px; text-align:center;">@Model.GrandTotal.ToString("N3")</td>
                </tr>
            </tbody>
        </table>

        <!-- تذييل -->
        <div style="margin-top:16px; text-align:center; font-size:0.75rem; color:#999; border-top:1px solid #ddd; padding-top:8px;">
            عدد السجلات: @Model.Items.Count()
        </div>
    </div>
</div>

<script>
    function printReport() {
        var content = document.getElementById('print-section').innerHTML;
        var original = document.body.innerHTML;
        document.body.innerHTML = content;
        window.print();
        document.body.innerHTML = original;
        location.reload();
    }
</script>