@model CarRentWeb.Models.MyModel.CollectionReportViewModel

@{
    ViewData["Title"] = "تقرير التحصيل";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var billsByEmp = Model.Bills
        .GroupBy(b => new { b.EmpCode, b.EmployeeName })
        .Select(g => new { g.Key.EmpCode, g.Key.EmployeeName, BillsTotal = g.Sum(x => x.Amount) })
        .ToList();

    var debitsByEmp = Model.DebitPayments
        .GroupBy(d => new { d.EmpCode, d.EmployeeName })
        .Select(g => new { g.Key.EmpCode, g.Key.EmployeeName, DebitsTotal = g.Sum(x => x.Amount) })
        .ToList();

    var allCodes = billsByEmp.Select(b => b.EmpCode)
        .Union(debitsByEmp.Select(d => d.EmpCode))
        .Distinct().OrderBy(c => c).ToList();

    var summaryRows = allCodes.Select(code =>
    {
        var bill  = billsByEmp.FirstOrDefault(b => b.EmpCode == code);
        var debit = debitsByEmp.FirstOrDefault(d => d.EmpCode == code);
        var name  = bill?.EmployeeName ?? debit?.EmployeeName ?? "";
        var bt    = bill?.BillsTotal ?? 0m;
        var dt    = debit?.DebitsTotal ?? 0m;
        return new { EmpCode = code, EmployeeName = name, BillsTotal = bt, DebitsTotal = dt, Total = bt + dt };
    }).ToList();

    string fromDate = ViewData["FromDateFilter"]?.ToString() ?? "";
    string toDate   = ViewData["ToDateFilter"]?.ToString() ?? "";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .report-header {
        text-align: right;
        margin-bottom: 6px;
    }

        .report-header h1 {
            color: #1a1a2e;
            font-weight: 800;
            font-size: 1.8rem;
            border-bottom: 3px solid #3498db;
            display: inline-block;
            padding-bottom: 4px;
        }

    .report-date {
        color: #555;
        font-size: 0.85rem;
        text-align: right;
        margin-bottom: 15px;
    }

    /* Summary Cards */
    .summary-cards {
        display: flex;
        gap: 16px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .summary-card {
        flex: 1;
        min-width: 180px;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        padding: 16px 20px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

        .summary-card .card-label {
            font-size: 0.82rem;
            color: #777;
            margin-bottom: 6px;
        }

        .summary-card .card-value {
            font-size: 1.5rem;
            font-weight: 700;
        }

    .card-value.bills {
        color: #2980b9;
    }

    .card-value.debits {
        color: #8e44ad;
    }

    .card-value.total {
        color: #1a1a2e;
    }

    /* Filter Bar */
    .filter-bar {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px 18px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
        direction: rtl;
    }

        .filter-bar label {
            font-weight: 600;
            color: #333;
            font-size: 0.83rem;
            white-space: nowrap;
        }

        .filter-bar input, .filter-bar select {
            padding: 6px 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 0.83rem;
            width: 130px;
        }

        .filter-bar select {
            width: 160px;
        }

        .filter-bar input[type="date"] {
            width: 145px;
        }

    .btn-search {
        background: #3498db;
        color: #fff;
        border: none;
        padding: 7px 18px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
    }

        .btn-search:hover {
            background: #2980b9;
        }

    .btn-reset {
        background: #6c757d;
        color: #fff;
        border: none;
        padding: 7px 18px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

        .btn-reset:hover {
            background: #5a6268;
            color: #fff;
        }

    /* Section Title */
    .section-title {
        font-size: 1rem;
        font-weight: 700;
        padding: 8px 14px;
        border-radius: 6px 6px 0 0;
        margin-bottom: 0;
        color: #fff;
    }

    .section-bills {
        background: #2980b9;
    }

    .section-debits {
        background: #8e44ad;
    }

    /* Table */
    .report-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
        margin-bottom: 24px;
    }

        .report-table thead tr {
            color: #fff;
            text-align: center;
        }

    .thead-bills {
        background: #2980b9;
    }

    .thead-debits {
        background: #8e44ad;
    }

    .report-table th, .report-table td {
        padding: 8px 10px;
        border-bottom: 1px solid #e0e0e0;
        text-align: center;
        white-space: nowrap;
    }

    .report-table tbody tr:nth-of-type(even) {
        background: #f8f9fa;
    }

    .report-table tbody tr:hover {
        background: #eaf4fb;
    }

    .totals-row {
        font-weight: 700;
        background: #f0f4f8 !important;
        border-top: 2px solid #333;
    }

    .btn-print {
        background: #28a745;
        color: #fff;
        border: none;
        padding: 9px 22px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 600;
        margin-top: 10px;
    }

        .btn-print:hover {
            background: #218838;
        }

    @@media print {
        .filter-bar, .btn-print {
            display: none !important;
        }
    }
</style>

<div dir="rtl">
    <div class="report-header"><h1>تقرير التحصيل</h1></div>
    <div class="report-date">التاريخ: @DateTime.Today.ToString("yyyy/MM/dd")</div>

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="summary-card">
            <div class="card-label">إجمالي تحصيل الإيجار</div>
            <div class="card-value bills">@Model.TotalBills.ToString("N2")</div>
        </div>
        <div class="summary-card">
            <div class="card-label">إجمالي تحصيل الديون</div>
            <div class="card-value debits">@Model.TotalDebitPayments.ToString("N2")</div>
        </div>
        <div class="summary-card">
            <div class="card-label">الإجمالي الكلي</div>
            <div class="card-value total">@Model.GrandTotal.ToString("N2")</div>
        </div>
    </div>

    <!-- Filters -->
    <form asp-action="CollectionReport" method="get">
        <div class="filter-bar">
            <label>رقم الموظف:</label>
            <input type="number" name="EmpCodeString" value="@ViewData["EmpCodeFilter"]" placeholder="رقم الموظف" />

            <label>اسم الموظف:</label>
            <input type="text" name="EmpSearch" value="@ViewData["EmpFilter"]" placeholder="اسم الموظف" />

            <label>الشركة:</label>
            <select name="companyId" asp-items="ViewBag.Companies">
                <option value="">-- جميع الشركات --</option>
            </select>

            <label>من:</label>
            <input type="date" name="FromDateSearch" value="@ViewData["FromDateFilter"]" />

            <label>إلى:</label>
            <input type="date" name="ToDateSearch" value="@ViewData["ToDateFilter"]" />

            <button type="submit" class="btn-search">بحث</button>
            <a asp-action="CollectionReport" class="btn-reset">إعادة تعيين</a>
        </div>
    </form>

    <!-- Bills Table -->
    <div class="section-title section-bills">تحصيل الإيجار</div>
    <table class="report-table">
        <thead>
            <tr class="thead-bills">
                <th>#</th>
                <th>رقم الفاتورة</th>
                <th>التاريخ</th>
                <th>كود الموظف</th>
                <th>اسم الموظف</th>
                <th>الشركة</th>
                <th>رقم العقد</th>
                <th>رقم السيارة</th>
                <th>المبلغ</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Bills.Any())
            {
                int row = 1;
                @foreach (var item in Model.Bills)
                {
                    <tr>
                        <td>@(row++)</td>
                        <td>@item.BillNo</td>
                        <td>@item.BillDate?.ToString("yyyy/MM/dd")</td>
                        <td>@item.EmpCode</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.CompanyName</td>
                        <td>@item.ContractNo</td>
                        <td>@item.CarNo</td>
                        <td style="color:#2980b9; font-weight:600;">@item.Amount.ToString("N2")</td>
                    </tr>
                }
                <tr class="totals-row">
                    <td colspan="8" style="text-align:right; padding-right:12px;">المجموع</td>
                    <td style="color:#2980b9;">@Model.TotalBills.ToString("N2")</td>
                </tr>
            }
            else
            {
                <tr><td colspan="9" style="text-align:center; padding:16px; color:#999;">لا توجد بيانات</td></tr>
            }
        </tbody>
    </table>

    <!-- Debit Payments Table -->
    <div class="section-title section-debits">تحصيل الديون</div>
    <table class="report-table">
        <thead>
            <tr class="thead-debits">
                <th>#</th>
                <th>رقم السند</th>
                <th>التاريخ</th>
                <th>كود الموظف</th>
                <th>اسم الموظف</th>
                <th>الشركة</th>
                <th>نوع الدين</th>
                <th>المبلغ</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DebitPayments.Any())
            {
                int row = 1;
                @foreach (var item in Model.DebitPayments)
                {
                    <tr>
                        <td>@(row++)</td>
                        <td>@item.DebitPayNo</td>
                        <td>@item.PayDate?.ToString("yyyy/MM/dd")</td>
                        <td>@item.EmpCode</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.CompanyName</td>
                        <td>@item.DebitType</td>
                        <td style="color:#8e44ad; font-weight:600;">@item.Amount.ToString("N2")</td>
                    </tr>
                }
                <tr class="totals-row">
                    <td colspan="7" style="text-align:right; padding-right:12px;">المجموع</td>
                    <td style="color:#8e44ad;">@Model.TotalDebitPayments.ToString("N2")</td>
                </tr>
            }
            else
            {
                <tr><td colspan="8" style="text-align:center; padding:16px; color:#999;">لا توجد بيانات</td></tr>
            }
        </tbody>
    </table>

    <button onclick="printReport()" class="btn-print">طباعة</button>

    <a asp-action="CollectionReportExcel"
       asp-controller="ContractDetails"
       asp-route-EmpCodeString="@ViewData["EmpCodeFilter"]"
       asp-route-EmpSearch="@ViewData["EmpFilter"]"
       asp-route-companyId="@ViewData["CompanyFilter"]"
       asp-route-FromDateSearch="@ViewData["FromDateFilter"]"
       asp-route-ToDateSearch="@ViewData["ToDateFilter"]"
       class="btn-print" style="background:#1d6f42; text-decoration:none; display:inline-block; margin-top:10px;">
        <i class="fas fa-file-excel"></i> تصدير إيكسل
    </a>
</div>

<!-- قسم الطباعة المخفي -->
<div id="print-summary" style="display:none">
    <div dir="rtl" style="font-family:'Arial',sans-serif; padding:20px;">
        <h2 style="text-align:center; font-size:1.1rem; margin-bottom:6px;">تقرير الإيجار اليومي</h2>
        <div style="display:flex; justify-content:space-between; font-size:0.82rem; margin-bottom:10px;">
            <span>@DateTime.Today.ToString("dd/MM/yyyy")</span>
            <span>من تاريخ @fromDate &nbsp;&nbsp; إلى تاريخ @toDate</span>
        </div>
        <table style="width:100%; border-collapse:collapse; font-size:0.82rem; text-align:center; direction:rtl;">
            <thead>
                <tr style="background:#1565c0; color:#fff;">
                    <th style="border:1px solid #000; padding:5px 8px;">تسلسل</th>
                    <th style="border:1px solid #000; padding:5px 8px;">رقم الموظف</th>
                    <th style="border:1px solid #000; padding:5px 8px;">اسم الموظف</th>
                    <th style="border:1px solid #000; padding:5px 8px;">الإيداع اليومي</th>
                    <th style="border:1px solid #000; padding:5px 8px;">تحصيل الديون</th>
                    <th style="border:1px solid #000; padding:5px 8px;">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @{ int printRowNum = 0; }
                @foreach (var row in summaryRows)
                {
                    printRowNum++;
                    <tr>
                        <td style="border:1px solid #ccc; padding:3px 8px;">@printRowNum</td>
                        <td style="border:1px solid #ccc; padding:3px 8px;">@row.EmpCode</td>
                        <td style="border:1px solid #ccc; padding:3px 8px; text-align:right;">@row.EmployeeName</td>
                        <td style="border:1px solid #ccc; padding:3px 8px;">@row.BillsTotal.ToString("N3")</td>
                        <td style="border:1px solid #ccc; padding:3px 8px;">@row.DebitsTotal.ToString("N3")</td>
                        <td style="border:1px solid #ccc; padding:3px 8px;">@row.Total.ToString("N3")</td>
                    </tr>
                }
                <tr style="font-weight:bold; background:#f0f0f0;">
                    <td colspan="3" style="border:1px solid #000; padding:4px 8px; text-align:center;">الإجمالي</td>
                    <td style="border:1px solid #000; padding:4px 8px;">@Model.TotalBills.ToString("N3")</td>
                    <td style="border:1px solid #000; padding:4px 8px;">@Model.TotalDebitPayments.ToString("N3")</td>
                    <td style="border:1px solid #000; padding:4px 8px;">@Model.GrandTotal.ToString("N3")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    function printReport() {
        var printContent = document.getElementById('print-summary').innerHTML;
        var original = document.body.innerHTML;
        document.body.innerHTML = printContent;
        window.print();
        document.body.innerHTML = original;
        location.reload();
    }
</script>