@model CarRentWeb.Models.Contract

@{
    ViewData["Title"] = "تعديل العقد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="company-info-container" dir="rtl">
    <div class="company-info-header">
        <h4>بيانات العقد</h4>
        <div class="action-buttons">
            <a asp-action="DetailsDaily" asp-route-id="@Model.Id" class="btn btn-secondary">البيانات العامة</a>
            <a asp-action="IndexDaily" class="btn btn-secondary">التعريفات</a>
        </div>
    </div>

    <div class="company-info-body" dir="rtl">
        <form asp-action="EditDailyContract" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-6">
                    <div class="info-section">
                        <div class="info-item">
                            <label>رقم العقد</label>
                            <span>@Model.ContractNo</span>
                        </div>
                        <div class="info-item">
                            <label>اسم الموظف</label>
                            <span>@Model.Employee?.FullNameAr</span>
                        </div>
                        <div class="info-item">
                            <label>كود السيارة</label>
                            <span>@Model.Car?.CarCode</span>
                        </div>
                        <div class="info-item">
                            <label>بداية العقد</label>
                            <span>@Model.StartDate?.ToString("M/d/yyyy")</span>
                        </div>
                        <div class="info-item">
                            <label>نهاية العقد</label>
                            <span>@Model.EndDate?.ToString("M/d/yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-section">
                        <div class="mb-3">
                            <label class="form-label fw-bold">نوع التأجير</label>
                            <select asp-for="RentalType" class="form-select" dir="rtl">
                                <option value="0">عادي</option>
                                <option value="1">تأجير مواعده بالتخفيض ثم التملك</option>
                                <option value="2">تأجير مخفض ملكية سائق</option>
                                <option value="3">تأجير مخفض ملكية شركة</option>
                            </select>
                        </div>

                        @if (Model.RentalType != null && Model.RentalType != 0)
                        {
                            <div class="mb-3">
                                <label asp-for="DiscountDate" class="form-label fw-bold">تاريخ التخفيض</label>
                                <input asp-for="DiscountDate" type="date" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="DiscountAmount" class="form-label fw-bold">مبلغ التخفيض</label>
                                <input asp-for="DiscountAmount" type="number" step="0.001" class="form-control" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> حفظ
                </button>
                <a asp-action="DetailsDaily" asp-route-id="@Model.Id" class="btn btn-secondary ms-2">
                    X إلغاء
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('select[name="RentalType"]').addEventListener('change', function () {
            if (this.value !== '0') {
                document.getElementById('discountFields').style.display = 'block';
            } else {
                document.getElementById('discountFields').style.display = 'none';
            }
        });
    </script>
}
