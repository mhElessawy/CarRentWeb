@model  CarRentWeb.Models.Contract

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Include Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<form asp-action="EndContractDaily" class="delete-confirmation-container">
    <div dir="rtl">
        <div class="delete-header">
            <h1 class="delete-title">إنتهاء العقد</h1>
            <div class="delete-warning alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>تحذير:</strong> سوف يتم إنتهاء العقد هل أنت متأكد .
            </div>
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
        <div class="company-details-card">
            <div class="card-header">
                <h4>تفاصيل بيانات العقد</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="detail-group">
                            <label>رقم العقد</label>
                            <div class="detail-value">@Html.DisplayFor(model => model.ContractNo)</div>
                        </div>
                        <div class="detail-group">
                            <label>اسم السواق </label>
                            <div class="detail-value">@Html.DisplayFor(model => model.Employee!.FullNameAr)</div>
                        </div>
                        <div class="detail-group">
                            <label>رقم السيارة</label>
                            <div class="detail-value">@Html.DisplayFor(model => model.Car!.CarCode)</div>
                        </div>
                        <div class="detail-group">
                            <label>المبلغ المدفوع</label>
                            <span>@ViewBag.totalPay</span>
                        </div>
                        <div class="detail-group">
                            <label>تاريخ إنتهاء الالعقد</label>
                            <input asp-for="ContractEndDate" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="detail-group">
                            <label>المبلغ الغير مدفوع حتى تاريخ إنتهاء العقد</label>
                            <div class="detail-value" id="unpaidAmountDisplay">@ViewBag.unpaidAmount</div>
                        </div>

                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="detail-group">
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle"></i>
                                سيتم تلقائياً تحويل المبلغ الغير مدفوع إلى دين (عقد قديم) عند تأكيد الإغلاق.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="detail-group">
                            <label>السبب</label>
                            <input asp-for="ContractEndReson" value="" class="form-control" />
                            </<div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="delete-actions">

                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger btn-lg delete-button">
                        <i class="fas fa-trash-alt"></i> تأكيد الإغلاق
                    </button>
                    <a asp-action="IndexDaily" class="btn btn-outline-secondary btn-lg cancel-button">
                        <i class="fas fa-times"></i> إالغاء
                    </a>
                </div>
            </div>
</form>

<script>
    (function () {
        var unpaidDetails = @Html.Raw(ViewBag.unpaidDetailsJson ?? "[]");
        var dateInput = document.getElementById("ContractEndDate");
        var display = document.getElementById("unpaidAmountDisplay");

        function recalc() {
            if (!dateInput.value) {
                return;
            }
            var total = unpaidDetails
                .filter(function (d) { return d.date && d.date <= dateInput.value; })
                .reduce(function (sum, d) { return sum + d.amount; }, 0);
            display.textContent = total.toFixed(3);
        }

        if (dateInput) {
            dateInput.addEventListener("change", recalc);
            recalc();
        }
    })();
</script>