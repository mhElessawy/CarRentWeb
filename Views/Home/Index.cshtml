@{
    var companyDashboard = ViewBag.CompanyDashboard as List<CarRentWeb.Models.MyModel.CompanyDashboardItem>;
}
@if (companyDashboard != null && companyDashboard.Any())
{
    <div class="container-fluid mt-2 mb-4" dir="rtl">
        <div class="company-table-card">
            <div class="company-table-header">
                <i class="bi bi-building me-2"></i>إحصائيات الشركات
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 company-stats-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>اسم الشركة</th>
                            <th class="text-center">السيارات المسموح بها<br /><small class="fw-normal">(وزارة الداخلية)</small></th>
                            <th class="text-center">السيارات الفعلية</th>
                            <th class="text-center">العقود الفعّالة</th>
                            <th class="text-center">نسبة الاستخدام</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rn = 0;
                        }
                        @foreach (var co in companyDashboard)
                        {
                            rn++;
                            var ratio = co.Ratio;
                            var barColor = ratio == null ? "#adb5bd"
                            : ratio >= 90 ? "#dc3545"
                            : ratio >= 70 ? "#fd7e14"
                            : "#198754";
                            var ratioText = ratio == null ? "—" : ratio.Value.ToString("0.#") + "%";
                            <tr>
                                <td class="text-muted small">@rn</td>
                                <td class="fw-semibold">@co.CompanyName</td>
                                <td class="text-center">
                                    @if (co.MoiAllowedCars.HasValue)
                                    {
                                        <span class="stat-pill stat-allowed">@co.MoiAllowedCars</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="stat-pill stat-actual">@co.ActualCars</span>
                                </td>
                                <td class="text-center">
                                    <span class="stat-pill stat-contracts">@co.ActiveContracts</span>
                                </td>
                                <td class="text-center" style="min-width:130px">
                                    @if (ratio != null)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="ratio-bar-bg flex-grow-1">
                                                <div class="ratio-bar-fill"
                                                     style="width:@(Math.Min(ratio.Value, 100))%;background:@barColor"></div>
                                            </div>
                                            <span class="ratio-label" style="color:@barColor">@ratioText</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">لا يوجد حد</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <style>
        .company-table-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .company-table-header {
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            color: white;
            padding: 14px 20px;
            font-weight: 700;
            font-size: 1rem;
        }

        .company-stats-table th {
            background: #f8f9fa;
            font-size: 0.82rem;
            font-weight: 600;
            white-space: nowrap;
            vertical-align: middle;
        }

        .company-stats-table td {
            vertical-align: middle;
            font-size: 0.9rem;
        }

        .stat-pill {
            display: inline-block;
            min-width: 38px;
            padding: 3px 10px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .stat-allowed {
            background: #e0ecff;
            color: #0d47a1;
        }

        .stat-actual {
            background: #e8f5e9;
            color: #1b5e20;
        }

        .stat-contracts {
            background: #fff3cd;
            color: #7d4e00;
        }

        .ratio-bar-bg {
            height: 8px;
            border-radius: 4px;
            background: #e9ecef;
        }

        .ratio-bar-fill {
            height: 100%;
            border-radius: 4px;
            transition: width .4s;
        }

        .ratio-label {
            font-size: 0.82rem;
            font-weight: 700;
            white-space: nowrap;
            min-width: 42px;
        }
    </style>
}

@{
    var info = ViewBag.DeffInfo as CarRentWeb.Models.DeffInformation;
}
@if (info != null)
{
    <div class="container mt-4" dir="rtl">
        <div class="row g-3">

            <!-- VPS -->
            <div class="col-md-3 col-sm-6">
                <div class="info-card" style="border-top: 4px solid #4e54c8;">
                    <div class="info-card-header">
                        <i class="fas fa-server"></i> VPS
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-label">الموقع</span>
                            <span class="info-value">
                                @if (!string.IsNullOrEmpty(info.SiteUrl))
                                {
                                    <a href="@info.SiteUrl" target="_blank">@info.SiteUrl</a>
                                }
                                else
                                {

                                    <span class="text-muted">—</span>
                                }
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">اسم المستخدم</span>
                            <span class="info-value">@(info.SiteUsername ?? "—")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">تاريخ التجديد</span>
                            <span class="info-value @(info.VpsRenewalDate.HasValue && info.VpsRenewalDate.Value <= DateTime.Now.AddDays(30) ? "text-danger fw-bold" : "")">
                                @(info.VpsRenewalDate.HasValue? info.VpsRenewalDate.Value.ToString("yyyy-MM-dd") : "—")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Domain -->
            <div class="col-md-3 col-sm-6">
                <div class="info-card" style="border-top: 4px solid #11998e;">
                    <div class="info-card-header">
                        <i class="fas fa-globe"></i> Domain
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-label">الموقع</span>
                            <span class="info-value">@(info.Domain ?? "—")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">اسم المستخدم</span>
                            <span class="info-value">@(info.DomainUsername ?? "—")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">تاريخ التجديد</span>
                            <span class="info-value @(info.DomainRenewalDate.HasValue && info.DomainRenewalDate.Value <= DateTime.Now.AddDays(30) ? "text-danger fw-bold" : "")">
                                @(info.DomainRenewalDate.HasValue? info.DomainRenewalDate.Value.ToString("yyyy-MM-dd") : "—")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SSL -->
            <div class="col-md-3 col-sm-6">
                <div class="info-card" style="border-top: 4px solid #f7971e;">
                    <div class="info-card-header">
                        <i class="fas fa-lock"></i> SSL
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-label">الموقع</span>
                            <span class="info-value">
                                @if (!string.IsNullOrEmpty(info.SslUrl))
                                {
                                    <a href="@info.SslUrl" target="_blank">@info.SslUrl</a>
                                }
                                else
                                {

                                    <span class="text-muted">—</span>
                                }
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">اسم المستخدم</span>
                            <span class="info-value">@(info.SslUsername ?? "—")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">تاريخ الانتهاء</span>
                            <span class="info-value @(info.SslRenewalDate.HasValue && info.SslRenewalDate.Value <= DateTime.Now.AddDays(30) ? "text-danger fw-bold" : "")">
                                @(info.SslRenewalDate.HasValue? info.SslRenewalDate.Value.ToString("yyyy-MM-dd") : "—")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Message -->
            <div class="col-md-3 col-sm-6">
                <div class="info-card" style="border-top: 4px solid #ff6b6b;">
                    <div class="info-card-header">
                        <i class="fas fa-sms"></i> Message
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <span class="info-label">الموقع</span>
                            <span class="info-value">
                                @if (!string.IsNullOrEmpty(info.MessageUrl))
                                {
                                    <a href="@info.MessageUrl" target="_blank">@info.MessageUrl</a>
                                }
                                else
                                {

                                    <span class="text-muted">—</span>
                                }
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">اسم المستخدم</span>
                            <span class="info-value">@(info.MessageUsername ?? "—")</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">تاريخ التجديد</span>
                            <span class="info-value @(info.MessageRenewalDate.HasValue && info.MessageRenewalDate.Value <= DateTime.Now.AddDays(30) ? "text-danger fw-bold" : "")">
                                @(info.MessageRenewalDate.HasValue? info.MessageRenewalDate.Value.ToString("yyyy-MM-dd") : "—")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <style>
        .info-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            overflow: hidden;
            height: 100%;
        }

        .info-card-header {
            background: #f8f9fa;
            padding: 10px 16px;
            font-weight: 700;
            font-size: 15px;
            color: #343a40;
        }

        .info-card-body {
            padding: 12px 16px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            border-bottom: 1px solid #f0f0f0;
            gap: 8px;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            color: #6c757d;
            font-size: 13px;
            white-space: nowrap;
        }

        .info-value {
            font-size: 13px;
            font-weight: 500;
            text-align: left;
            word-break: break-all;
        }
    </style>
}
<section class="hero" style="text-align:center">
    <img src="~/assets/img/hero.jpg" alt="Hero Image" class="hero-image">
</section>