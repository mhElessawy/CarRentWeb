﻿﻿﻿@{
ViewData["Title"] = "Home Page";
}

<style>
    .cards-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
        direction: rtl; /* RTL for Arabic */
    }

    .card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        width: 200px;
        padding: 20px;
        text-align: center;
        transition: transform 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .count-badge {
        color: white;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: bold;
        margin: 0 auto 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .image-container {
        width: 80px;
        height: 80px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border-radius: 12px;
        padding: 10px;
    }

        .image-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    .card-title {
        color: #495057;
        font-size: 16px;
        font-weight: 600;
        margin: 0;
    }

    .card-link {
        text-decoration: none;
        color: inherit;
    }

    .hero-image {
        max-width: 100%;
        height: auto;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .cards-container {
            gap: 12px;
            padding: 0 8px;
        }

        .card {
            width: calc(50% - 12px);
            min-width: 0;
            padding: 14px 10px;
        }

        .count-badge {
            width: 56px;
            height: 56px;
            font-size: 20px;
            margin-bottom: 10px;
        }

        .image-container {
            width: 56px;
            height: 56px;
            margin-bottom: 10px;
        }

        .card-title {
            font-size: 13px;
        }
    }

    @@media (max-width: 400px) {
        .card {
            width: 100%;
        }
    }

</style>

