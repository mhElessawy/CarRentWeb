@{
    // Helper: returns CSS gradient based on days left
    string RenewalGradient(int? days)
    {
        if (days == null) return "linear-gradient(135deg, #b0bec5 0%, #cfd8dc 100%)";
        if (days <= 7) return "linear-gradient(135deg, #e53935 0%, #ff5252 100%)";
        if (days <= 30) return "linear-gradient(135deg, #fb8c00 0%, #ffd54f 100%)";
        return "linear-gradient(135deg, #2e7d32 0%, #66bb6a 100%)";
    }
    string RenewalIconBg(int? days)
    {
        if (days == null) return "#eceff1";
        if (days <= 7) return "#ffebee";
        if (days <= 30) return "#fff3e0";
        return "#e8f5e9";
    }
    string RenewalIconColor(int? days)
    {
        if (days == null) return "#90a4ae";
        if (days <= 7) return "#e53935";
        if (days <= 30) return "#fb8c00";
        return "#2e7d32";
    }
    string DaysLabel(int? days)
    {
        if (days == null) return "غير محدد";
        if (days < 0) return $"منتهي منذ {Math.Abs(days.Value)} يوم";
        if (days == 0) return "ينتهي اليوم";
        return $"باقي {days} يوم";
    }
}

@if (ViewBag.VpsRenewalDate != null || ViewBag.DomainRenewalDate != null ||
     ViewBag.SslRenewalDate != null || ViewBag.MessageRenewalDate != null)
{
    <br />
    <section dir="rtl">
        <h5 style="text-align:right; padding: 0 10px; color:#495057;">تواريخ التجديد</h5>
        <div class="cards-container">

            @if (ViewBag.VpsRenewalDate != null)
            {
                int? vDays = ViewBag.VpsDaysLeft;
                <div class="card renewal-card">
                    <div class="card-body">
                        <div class="count-badge" style="background: @RenewalGradient(vDays); font-size:13px; width:90px; height:90px;">
                            @DaysLabel(vDays)
                        </div>
                        <div class="image-container" style="background: @RenewalIconBg(vDays);">
                            <i class="bi bi-server" style="font-size:2.5rem; color:@RenewalIconColor(vDays);"></i>
                        </div>
                        <h3 class="card-title">تجديد VPS</h3>
                        <p class="renewal-date">@(((DateTime)ViewBag.VpsRenewalDate).ToString("yyyy-MM-dd"))</p>
                    </div>
                </div>
            }

            @if (ViewBag.DomainRenewalDate != null)
            {
                int? dDays = ViewBag.DomainDaysLeft;
                <div class="card renewal-card">
                    <div class="card-body">
                        <div class="count-badge" style="background: @RenewalGradient(dDays); font-size:13px; width:90px; height:90px;">
                            @DaysLabel(dDays)
                        </div>
                        <div class="image-container" style="background: @RenewalIconBg(dDays);">
                            <i class="bi bi-globe" style="font-size:2.5rem; color:@RenewalIconColor(dDays);"></i>
                        </div>
                        <h3 class="card-title">تجديد Domain</h3>
                        <p class="renewal-date">@(((DateTime)ViewBag.DomainRenewalDate).ToString("yyyy-MM-dd"))</p>
                    </div>
                </div>
            }

            @if (ViewBag.SslRenewalDate != null)
            {
                int? sDays = ViewBag.SslDaysLeft;
                <div class="card renewal-card">
                    <div class="card-body">
                        <div class="count-badge" style="background: @RenewalGradient(sDays); font-size:13px; width:90px; height:90px;">
                            @DaysLabel(sDays)
                        </div>
                        <div class="image-container" style="background: @RenewalIconBg(sDays);">
                            <i class="bi bi-shield-lock" style="font-size:2.5rem; color:@RenewalIconColor(sDays);"></i>
                        </div>
                        <h3 class="card-title">تجديد SSL</h3>
                        <p class="renewal-date">@(((DateTime)ViewBag.SslRenewalDate).ToString("yyyy-MM-dd"))</p>
                    </div>
                </div>
            }

            @if (ViewBag.MessageRenewalDate != null)
            {
                int? mDays = ViewBag.MessageDaysLeft;
                <div class="card renewal-card">
                    <div class="card-body">
                        <div class="count-badge" style="background: @RenewalGradient(mDays); font-size:13px; width:90px; height:90px;">
                            @DaysLabel(mDays)
                        </div>
                        <div class="image-container" style="background: @RenewalIconBg(mDays);">
                            <i class="bi bi-chat-dots" style="font-size:2.5rem; color:@RenewalIconColor(mDays);"></i>
                        </div>
                        <h3 class="card-title">تجديد Message</h3>
                        <p class="renewal-date">@(((DateTime)ViewBag.MessageRenewalDate).ToString("yyyy-MM-dd"))</p>
                    </div>
                </div>
            }

        </div>
    </section>
}

<style>
    .renewal-card {
        border-top: 3px solid #dee2e6;
    }

    .renewal-date {
        font-size: 12px;
        color: #6c757d;
        margin: 6px 0 0;
    }
</style>

<br />

<section class="hero" style="text-align:center">
    <img src="~/assets/img/hero.jpg" alt="Hero Image" class="hero-image">
</section>