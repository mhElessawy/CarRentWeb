@model List<PeriodicScheduleItem>

@{
    ViewData["Title"] = "جدول مهام المندوب - دورية";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var allDefs = ViewBag.AllDefs as List<CarRentWeb.Models.PeriodicTaskDef> ?? new();
    var dateFromVal = ViewBag.DateFrom as string ?? "";
    var dateToVal = ViewBag.DateTo as string ?? "";
    var nameSearch = ViewBag.NameSearch as string ?? "";
    int? selectedDefId = ViewBag.SelectedTaskDefId;
    string selectedSource = ViewBag.SelectedSourceType ?? "";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: white;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }
    .schedule-table th {
        background: #f8f9fa;
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .schedule-table td { vertical-align: middle; font-size: 0.9rem; }
    .date-input {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 5px 8px;
        font-size: 0.85rem;
        width: 140px;
    }
    .date-input:focus { border-color: #0d6efd; outline: none; box-shadow: 0 0 0 2px rgba(13,110,253,.15); }
    .overdue { background: #fff5f5 !important; }
    .overdue .date-input { border-color: #dc3545; color: #dc3545; }
    .today-row { background: #fffbf0 !important; }
    .meta-tag { font-size: 0.78rem; color: #6c757d; }
    .source-badge {
        font-size: 0.78rem;
        padding: 2px 8px;
        border-radius: 5px;
    }

    @@media print {
        body { direction: rtl; font-family: Arial, sans-serif; font-size: 12px; }
        .no-print { display: none !important; }
        .print-header { display: block !important; text-align: center; margin-bottom: 16px; border-bottom: 2px solid #333; padding-bottom: 10px; }
        .print-header h4 { margin: 0 0 4px; font-size: 16px; }
        .print-header p { margin: 0; font-size: 12px; color: #555; }
        .schedule-table th { background: #eee !important; -webkit-print-color-adjust: exact; }
        .schedule-table td, .schedule-table th { border: 1px solid #ccc !important; padding: 5px 8px !important; }
        .overdue { background: #ffe0e0 !important; -webkit-print-color-adjust: exact; }
        .today-row { background: #fff8dc !important; -webkit-print-color-adjust: exact; }
        .col-save { display: none !important; }
        .col-date-val { display: table-cell !important; }
    }
    .print-header { display: none; }
    .col-date-val { display: none; }
</style>

<div class="container-fluid mt-3" dir="rtl">

    <div class="print-header">
        <h4>جدول مهام المندوب - المهام الدورية</h4>
        <p>تاريخ الطباعة: @today.ToString("yyyy/MM/dd")</p>
    </div>

    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 no-print">
        <div>
            <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>جدول مهام المندوب - المهام الدورية</h5>
            <small class="opacity-75">تحديد تواريخ التنفيذ للمهام الدورية المستحقة</small>
        </div>
        <a asp-action="Index" asp-controller="PeriodicTaskInstances" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-right me-1"></i> المهام النشطة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible no-print">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <form method="get" class="card p-3 mb-3 shadow-sm no-print" style="border-radius:10px">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">نوع المهمة</label>
                <select name="taskDefId" class="form-select form-select-sm" dir="rtl">
                    <option value="">-- كل المهام --</option>
                    @foreach (var d in allDefs)
                    {
                        <option value="@d.Id" selected="@(selectedDefId == d.Id)">@d.TaskName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">المصدر</label>
                <select name="sourceType" class="form-select form-select-sm" dir="rtl">
                    <option value="" selected="@(selectedSource == "")">-- الكل --</option>
                    <option value="Employee" selected="@(selectedSource == "Employee")">الموظفين</option>
                    <option value="Car" selected="@(selectedSource == "Car")">السيارات</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">بحث بالاسم</label>
                <input type="text" name="nameSearch" class="form-control form-control-sm"
                       placeholder="ابحث..." value="@nameSearch" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">تاريخ التنفيذ من</label>
                <input type="date" name="dateFrom" class="form-control form-control-sm" value="@dateFromVal" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">تاريخ التنفيذ إلى</label>
                <input type="date" name="dateTo" class="form-control form-control-sm" value="@dateToVal" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-search"></i></button>
                <a asp-action="Schedule" class="btn btn-outline-secondary btn-sm" title="مسح"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted no-print">
            <i class="bi bi-calendar-check fs-1 d-block mb-2 text-primary"></i>
            <div class="fw-semibold">لا توجد مهام مطابقة</div>
            <div class="small">جرّب تغيير الفلتر أو مسحه</div>
        </div>
    }
    else
    {
        var overdueCount = Model.Count(x => x.TargetDate.HasValue && x.TargetDate.Value < today);
        var todayCount   = Model.Count(x => x.TargetDate.HasValue && x.TargetDate.Value == today);

        <div class="d-flex align-items-center gap-3 mb-3 no-print">
            <span class="fw-semibold text-muted small">
                <i class="bi bi-list-check me-1"></i>@Model.Count مهمة
            </span>
            @if (overdueCount > 0) { <span class="badge bg-danger">@overdueCount متأخر</span> }
            @if (todayCount > 0)   { <span class="badge bg-warning text-dark">@todayCount اليوم</span> }
            <button class="btn btn-outline-secondary btn-sm me-auto no-print" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> طباعة
            </button>
        </div>

        <div class="card shadow-sm" style="border-radius:10px;overflow:hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 schedule-table">
                    <thead>
                        <tr>
                            <th class="px-3">#</th>
                            <th>المهمة</th>
                            <th>المرتبط</th>
                            <th>النوع</th>
                            <th>@Html.Raw("تاريخ الانتهاء")</th>
                            <th>المتبقي</th>
                            <th>تاريخ التنفيذ المطلوب</th>
                            <th class="col-save no-print"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 0; }
                        @foreach (var item in Model)
                        {
                            rowNum++;
                            var isOverdue = item.TargetDate.HasValue && item.TargetDate.Value < today;
                            var isToday   = item.TargetDate.HasValue && item.TargetDate.Value == today;
                            var rowClass  = isOverdue ? "overdue" : isToday ? "today-row" : "";
                            var daysClass = item.DaysLeft < 0 ? "text-danger fw-semibold"
                                          : item.DaysLeft <= 7 ? "text-warning fw-semibold"
                                          : "text-muted";

                            <tr class="@rowClass">
                                <td class="px-3 text-muted small">@rowNum</td>
                                <td><strong>@item.TaskName</strong></td>
                                <td>
                                    <div class="fw-semibold">@item.EntityName</div>
                                    <div class="meta-tag">@item.FieldLabel</div>
                                </td>
                                <td>
                                    @if (item.SourceType == "Car")
                                    {
                                        <span class="source-badge bg-info text-dark"><i class="bi bi-car-front-fill me-1"></i>سيارة</span>
                                    }
                                    else
                                    {
                                        <span class="source-badge bg-success text-white"><i class="bi bi-person-fill me-1"></i>موظف</span>
                                    }
                                </td>
                                <td class="@daysClass small">@item.DueDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    <span class="badge @(item.DaysLeft < 0 ? "bg-danger" : item.DaysLeft <= 7 ? "bg-warning text-dark" : item.DaysLeft <= 30 ? "bg-info text-dark" : "bg-secondary")">
                                        @(item.DaysLeft < 0 ? $"منتهي {-item.DaysLeft}ي" : item.DaysLeft == 0 ? "اليوم" : $"{item.DaysLeft} يوم")
                                    </span>
                                </td>
                                <!-- Print: show date as text -->
                                <td class="col-date-val">
                                    @if (item.TargetDate.HasValue)
                                    {
                                        <span class="@(isOverdue ? "text-danger fw-semibold" : isToday ? "text-warning fw-semibold" : "")">
                                            @item.TargetDate.Value.ToString("yyyy/MM/dd")
                                            @if (isOverdue) { <text> ⚠</text> }
                                            @if (isToday)   { <text> ★</text> }
                                        </span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <!-- Screen: editable date + save -->
                                <td class="col-save no-print">
                                    <form asp-action="SaveTargetDate" method="post" class="d-flex align-items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="instanceId" value="@item.InstanceId" />
                                        <input type="hidden" name="taskDefId" value="@selectedDefId" />
                                        <input type="hidden" name="sourceType" value="@selectedSource" />
                                        <input type="hidden" name="nameSearch" value="@nameSearch" />
                                        <input type="hidden" name="dateFrom" value="@dateFromVal" />
                                        <input type="hidden" name="dateTo" value="@dateToVal" />
                                        <input type="date" name="targetDate" class="date-input"
                                               value="@(item.TargetDate?.ToString("yyyy-MM-dd") ?? "")" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary px-2" title="حفظ">
                                            <i class="bi bi-save"></i>
                                        </button>
                                    </form>
                                    @if (isOverdue) { <div class="meta-tag text-danger mt-1"><i class="bi bi-exclamation-circle me-1"></i>متأخر</div> }
                                    @if (isToday)   { <div class="meta-tag text-warning mt-1"><i class="bi bi-clock me-1"></i>اليوم</div> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
