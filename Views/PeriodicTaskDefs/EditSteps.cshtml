@model CarRentWeb.Models.PeriodicTaskDef
@using CarRentWeb.Helpers

@{
    ViewData["Title"] = "تعديل المهمة وإدارة خطواتها";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empFields = (Dictionary<string, string>)ViewBag.EmployeeFields;
    var carFields = (Dictionary<string, string>)ViewBag.CarFields;
    var fieldLabel = PeriodicTaskHelper.GetFieldLabel(Model.SourceType, Model.DateFieldName);
}

<div class="container mt-4" dir="rtl">

    <!-- بيانات المهمة -->
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0" style="color:white">
                <i class="bi bi-pencil-square"></i> تعديل بيانات المهمة: @Model.TaskName
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="EditSteps" class="row g-3">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="col-md-6">
                    <label asp-for="TaskName" class="form-label">اسم المهمة</label>
                    <input asp-for="TaskName" class="form-control" required />
                </div>

                <div class="col-md-3">
                    <label asp-for="AlertDaysBefore" class="form-label">التنبيه قبل (أيام)</label>
                    <input asp-for="AlertDaysBefore" type="number" min="1" max="365" class="form-control" />
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive">مهمة نشطة</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <label asp-for="SourceType" class="form-label">المصدر</label>
                    <select asp-for="SourceType" id="sourceTypeSelect" class="form-select" onchange="updateFields()">
                        <option value="Employee" selected="@(Model.SourceType == "Employee")">الموظفين</option>
                        <option value="Car" selected="@(Model.SourceType == "Car")">السيارات</option>
                    </select>
                </div>

                <div class="col-md-8">
                    <label asp-for="DateFieldName" class="form-label">حقل تاريخ الانتهاء</label>
                    <select asp-for="DateFieldName" id="dateFieldSelect" class="form-select">
                        @if (Model.SourceType == "Employee")
                        {
                            @foreach (var kv in empFields)
                            {
                                <option value="@kv.Key" selected="@(Model.DateFieldName == kv.Key)">@kv.Value</option>
                            }
                        }
                        else
                        {
                            @foreach (var kv in carFields)
                            {
                                <option value="@kv.Key" selected="@(Model.DateFieldName == kv.Key)">@kv.Value</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> حفظ التعديلات
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- خطوات التجديد -->
    <div class="card shadow">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0" style="color:white">
                <i class="bi bi-list-check"></i> خطوات التجديد
                <span class="badge bg-light text-dark ms-2">@Model.Steps.Count خطوة</span>
            </h5>
        </div>
        <div class="card-body">

            @if (Model.Steps.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px">الترتيب</th>
                                <th>اسم الخطوة</th>
                                <th>الجهة</th>
                                <th>الموقع</th>
                                <th style="width:80px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var step in Model.Steps)
                            {
                                <tr>
                                    <td class="text-center">@step.StepOrder</td>
                                    <td><strong>@step.StepName</strong></td>
                                    <td>@step.Authority</td>
                                    <td>@step.Location</td>
                                    <td>
                                        <form asp-action="DeleteStep" method="post"
                                              onsubmit="return confirm('حذف هذه الخطوة؟')">
                                            <input type="hidden" name="stepId" value="@step.Id" />
                                            <input type="hidden" name="taskDefId" value="@Model.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-triangle"></i> لا توجد خطوات بعد. أضف الخطوات أدناه.
                </div>
            }

            <!-- إضافة خطوة جديدة -->
            <div class="border rounded p-3 bg-light">
                <h6 class="mb-3"><i class="bi bi-plus-circle text-success"></i> إضافة خطوة جديدة</h6>
                <form asp-action="AddStep" method="post" class="row g-2">
                    <input type="hidden" name="taskDefId" value="@Model.Id" />
                    @Html.AntiForgeryToken()

                    <div class="col-md-4">
                        <input type="text" name="stepName" class="form-control"
                               placeholder="اسم الخطوة (مثال: التأمين)" required />
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="authority" class="form-control"
                               placeholder="الجهة" />
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="location" class="form-control"
                               placeholder="الموقع" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus"></i> إضافة
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> رجوع للقائمة
            </a>
        </div>
    </div>
</div>

<script>
    var employeeFields = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(empFields));
    var carFields = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(carFields));

    function updateFields() {
        var source = document.getElementById('sourceTypeSelect').value;
        var sel = document.getElementById('dateFieldSelect');
        sel.innerHTML = '';
        var fields = source === 'Car' ? carFields : employeeFields;
        for (var key in fields) {
            sel.innerHTML += `<option value="${key}">${fields[key]}</option>`;
        }
    }
</script>