@model CarRentWeb.Models.SteppedAdminTask

@{
    ViewData["Title"] = "تفاصيل المهمة";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = (DateOnly)ViewBag.Today;
    int doneSteps = Model.Steps.Count(s => s.IsCompleted);
    int totalSteps = Model.Steps.Count;
    int pct = totalSteps > 0 ? (doneSteps * 100 / totalSteps) : 0;
}

<style>
    .task-header {
        background: linear-gradient(135deg, #6f42c1, #5a2d91);
        color: white;
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 20px;
    }
    .step-card {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 10px;
        background: white;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .step-card.done {
        border-color: #198754;
        background: #f0fff4;
    }
    .step-card.overdue {
        border-color: #dc3545;
        background: #fff5f5;
    }
    .step-num {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        font-weight: 700;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .step-card.done .step-num {
        background: #198754;
        color: white;
    }
    .step-card.overdue .step-num {
        background: #dc3545;
        color: white;
    }
</style>

<div class="container-fluid mt-3" dir="rtl">

    <div class="mb-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i> مهام إدارية بخطوات
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil-fill me-1"></i> تعديل المهمة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Task Header -->
    <div class="task-header">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h5 class="mb-1 fw-bold">@Model.TaskTitle</h5>
                @if (!string.IsNullOrEmpty(Model.AssignedTo))
                {
                    <div class="opacity-75 small">
                        <i class="bi bi-person-fill me-1"></i> مكلف إلى: <strong>@Model.AssignedTo</strong>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="opacity-75 small mt-1">
                        <i class="bi bi-chat-left-text me-1"></i>@Model.Notes
                    </div>
                }
            </div>
            <div class="text-end">
                @if (Model.IsCompleted)
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-check-all me-1"></i>مكتملة</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6"><i class="bi bi-hourglass-split me-1"></i>قيد التنفيذ</span>
                }
                <div class="small opacity-75 mt-1">
                    أُنشئت: @Model.CreatedDate.ToString("yyyy/MM/dd")
                    @if (!string.IsNullOrEmpty(Model.CreatedBy))
                    {
                        <span> بواسطة @Model.CreatedBy</span>
                    }
                </div>
            </div>
        </div>

        <!-- Progress Bar -->
        <div class="mt-3">
            <div class="d-flex justify-content-between small mb-1">
                <span>@doneSteps من @totalSteps خطوات مكتملة</span>
                <span>@pct%</span>
            </div>
            <div class="progress" style="height:10px;border-radius:5px;background:rgba(255,255,255,0.3)">
                <div class="progress-bar bg-white" role="progressbar" style="width:@pct%"></div>
            </div>
        </div>
    </div>

    <!-- Steps -->
    <h6 class="fw-bold mb-3"><i class="bi bi-list-ol me-1"></i> خطوات المهمة</h6>

    @foreach (var step in Model.Steps.OrderBy(s => s.StepOrder))
    {
        bool isOverdue = !step.IsCompleted && step.TargetDate < today;
        bool isToday = !step.IsCompleted && step.TargetDate == today;
        string cardClass = step.IsCompleted ? "done" : isOverdue ? "overdue" : "";
        int daysLeft = step.TargetDate.DayNumber - today.DayNumber;
        int delay = today.DayNumber - step.TargetDate.DayNumber;

        <div class="step-card @cardClass">
            <div class="d-flex align-items-center gap-3">
                <div class="step-num">
                    @if (step.IsCompleted)
                    {
                        <i class="bi bi-check2"></i>
                    }
                    else
                    {
                        @step.StepOrder
                    }
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold @(step.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                        @step.StepName
                    </div>
                    <div class="small mt-1">
                        <i class="bi bi-calendar2 me-1"></i>
                        <span class="@(isOverdue ? "text-danger fw-semibold" : isToday ? "text-warning fw-semibold" : "text-muted")">
                            @step.TargetDate.ToString("yyyy/MM/dd")
                        </span>

                        @if (step.IsCompleted)
                        {
                            <span class="badge bg-success ms-2"><i class="bi bi-check2 me-1"></i>مكتملة</span>
                            @if (step.CompletedDate.HasValue)
                            {
                                <span class="text-muted ms-1" style="font-size:0.75rem">
                                    في @step.CompletedDate.Value.ToString("yyyy/MM/dd")
                                </span>
                            }
                        }
                        else if (isOverdue)
                        {
                            <span class="badge bg-danger ms-2">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>تأخر @delay يوم
                            </span>
                        }
                        else if (isToday)
                        {
                            <span class="badge bg-warning text-dark ms-2">
                                <i class="bi bi-clock-fill me-1"></i>اليوم
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border ms-2">@daysLeft يوم متبقي</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(step.Notes))
                    {
                        <div class="text-muted small mt-1">
                            <i class="bi bi-chat-left-text me-1"></i>@step.Notes
                        </div>
                    }
                </div>
                <div>
                    <form asp-action="ToggleStep" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="stepId" value="@step.Id" />
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <button type="submit"
                                class="btn btn-sm @(step.IsCompleted ? "btn-outline-secondary" : "btn-outline-success")"
                                title="@(step.IsCompleted ? "إعادة فتح" : "تعليم كمكتملة")">
                            <i class="bi @(step.IsCompleted ? "bi-arrow-counterclockwise" : "bi-check2-circle")"></i>
                            @(step.IsCompleted ? "إعادة فتح" : "تم")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
