@model List<SteppedAdminTask>
@using CarRentWeb.Models

@{
    ViewData["Title"] = "مهام إدارية بخطوات";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = (DateOnly)ViewBag.Today;
    var status = ViewBag.Status as string ?? "";
    var search = ViewBag.Search as string ?? "";
    var assignedTo = ViewBag.AssignedTo as string ?? "";

    int totalCount = Model.Count;
    int completedCount = Model.Count(t => t.IsCompleted);
    int pendingCount = Model.Count(t => !t.IsCompleted);
}

<style>
    .page-header {
        background: linear-gradient(135deg, #6f42c1, #5a2d91);
        color: white;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }

    .stat-card {
        border-radius: 10px;
        padding: 12px 16px;
        color: white;
        text-align: center;
    }

    .task-card {
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        background: white;
        margin-bottom: 12px;
        transition: box-shadow 0.2s;
    }

        .task-card:hover {
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        .task-card.completed {
            background: #f0fff4;
            border-color: #c3e6cb;
            opacity: .9;
        }

    .step-pill {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        margin: 2px;
    }
</style>

<div class="container-fluid mt-3" dir="rtl">

    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0"><i class="bi bi-diagram-3-fill me-2"></i>مهام إدارية بخطوات</h5>
            <small class="opacity-75">مهام متعددة الخطوات مع تواريخ تنفيذ لكل خطوة</small>
        </div>
        <a asp-action="Create" class="btn btn-light btn-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> مهمة جديدة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible">
            <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-3">
        <div class="col-4">
            <div class="stat-card bg-secondary">
                <div class="fs-4 fw-bold">@totalCount</div>
                <div class="small opacity-75">الإجمالي</div>
            </div>
        </div>
        <div class="col-4">
            <div class="stat-card bg-warning text-dark">
                <div class="fs-4 fw-bold">@pendingCount</div>
                <div class="small">قيد التنفيذ</div>
            </div>
        </div>
        <div class="col-4">
            <div class="stat-card bg-success">
                <div class="fs-4 fw-bold">@completedCount</div>
                <div class="small opacity-75">مكتملة</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" class="card p-3 mb-3 shadow-sm" style="border-radius:10px">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">بحث</label>
                <input type="text" name="search" class="form-control form-control-sm"
                       placeholder="ابحث في المهام..." value="@search" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">المكلف</label>
                <select name="assignedTo" class="form-select form-select-sm" dir="rtl">
                    <option value="">-- الكل --</option>
                    @foreach (dynamic u in ViewBag.Users)
                    {
                        <option value="@u.UserName" selected="@(assignedTo == (string)u.UserName)">@u.UserFullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">الحالة</label>
                <select name="status" class="form-select form-select-sm" dir="rtl">
                    <option value="" selected="@(status == "")">-- الكل --</option>
                    <option value="pending" selected="@(status == "pending")">قيد التنفيذ</option>
                    <option value="completed" selected="@(status == "completed")">مكتملة</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1 align-items-end">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-search me-1"></i> بحث
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-diagram-3 fs-1 d-block mb-2 text-primary"></i>
            <div class="fw-semibold">لا توجد مهام مطابقة</div>
            <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
                <i class="bi bi-plus-circle me-1"></i> إضافة مهمة جديدة
            </a>
        </div>
    }
    else
    {
        @foreach (var task in Model)
        {
            int doneSteps = task.Steps.Count(s => s.IsCompleted);
            int totalSteps = task.Steps.Count;
            int pct = totalSteps > 0 ? (doneSteps * 100 / totalSteps) : 0;

            <div class="task-card @(task.IsCompleted ? "completed" : "") p-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <div class="fw-bold fs-6 @(task.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                            @task.TaskTitle
                        </div>
                        @if (!string.IsNullOrEmpty(task.AssignedTo))
                        {
                            <div class="small text-muted mt-1">
                                <i class="bi bi-person-fill me-1"></i>@task.AssignedTo
                            </div>
                        }
                    </div>
                    <div class="d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@task.Id"
                           class="btn btn-sm btn-outline-primary" title="تفاصيل وتتبع الخطوات">
                            <i class="bi bi-eye-fill"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@task.Id"
                           class="btn btn-sm btn-outline-secondary" title="تعديل">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('هل تريد حذف هذه المهمة؟')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@task.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="mt-2">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>@doneSteps من @totalSteps خطوات مكتملة</span>
                        <span>@pct%</span>
                    </div>
                    <div class="progress" style="height:8px;border-radius:4px">
                        <div class="progress-bar @(task.IsCompleted ? "bg-success" : "bg-primary")"
                             role="progressbar" style="width:@pct%"></div>
                    </div>
                </div>

                <!-- Steps Pills -->
                @if (task.Steps.Any())
                {
                    <div class="mt-2">
                        @foreach (var step in task.Steps.OrderBy(s => s.StepOrder))
                        {
                            bool stepOverdue = !step.IsCompleted && step.TargetDate < today;
                            string pillClass = step.IsCompleted ? "bg-success text-white"
                            : stepOverdue ? "bg-danger text-white"
                            : "bg-light text-dark border";
                            <span class="step-pill @pillClass">
                                @if (step.IsCompleted)
                                {
                                    <i class="bi bi-check2 me-1"></i>
                                }
                                @step.StepName
                                <small class="opacity-75 ms-1">(@step.TargetDate.ToString("MM/dd"))</small>
                            </span>
                        }
                    </div>
                }
            </div>
        }
    }
</div>