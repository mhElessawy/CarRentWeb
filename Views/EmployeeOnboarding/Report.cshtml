@model List<CarRentWeb.Models.MyModel.OnboardingReportItem>

@{
    ViewData["Title"] = "تقرير الأعمال المنجزة";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var tdfVal = ViewBag.TargetDateFrom as string ?? "";
    var tdtVal = ViewBag.TargetDateTo as string ?? "";
    var cdfVal = ViewBag.CompletedDateFrom as string ?? "";
    var cdtVal = ViewBag.CompletedDateTo as string ?? "";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #198754, #146c43);
        color: white;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }

    .report-table th {
        background: #f8f9fa;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .report-table td {
        vertical-align: middle;
        font-size: 0.88rem;
    }

    .step-badge {
        background: #e8f4fd;
        color: #0d6efd;
        border-radius: 6px;
        padding: 2px 8px;
        font-size: 0.8rem;
        font-weight: 500;
        display: inline-block;
    }

    .meta-tag {
        font-size: 0.76rem;
        color: #6c757d;
    }

    .date-cell {
        white-space: nowrap;
    }

    .diff-late {
        color: #dc3545;
        font-weight: 600;
    }

    .diff-ontime {
        color: #198754;
        font-weight: 600;
    }

    .diff-early {
        color: #0d6efd;
        font-weight: 600;
    }

    .filter-section {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .filter-group-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 6px;
    }

    /* ===== Print ===== */
    @@media print {
        body {
            direction: rtl;
            font-family: Arial, sans-serif;
            font-size: 11px;
        }

        .no-print {
            display: none !important;
        }

        .print-header {
            display: block !important;
            text-align: center;
            margin-bottom: 14px;
            border-bottom: 2px solid #333;
            padding-bottom: 8px;
        }

            .print-header h4 {
                margin: 0 0 3px;
                font-size: 15px;
            }

            .print-header p {
                margin: 0;
                font-size: 11px;
                color: #555;
            }

        .report-table th {
            background: #eee !important;
            -webkit-print-color-adjust: exact;
        }

        .report-table td,
        .report-table th {
            border: 1px solid #ccc !important;
            padding: 4px 6px !important;
        }

        .step-badge {
            background: #d0e8ff !important;
            -webkit-print-color-adjust: exact;
        }
    }

    .print-header {
        display: none;
    }
</style>

<div class="container-fluid mt-3" dir="rtl">

    <!-- Print header -->
    <div class="print-header">
        <h4>تقرير الأعمال المنجزة — تجهيز السائقين</h4>
        <p>
            @{
                var parts = new List<string>();
                if (!string.IsNullOrEmpty(tdfVal) || !string.IsNullOrEmpty(tdtVal))
                    parts.Add("تاريخ التجهيز: " + (tdfVal == "" ? "—" : tdfVal) + " إلى " + (tdtVal == "" ? "—" : tdtVal));
                if (!string.IsNullOrEmpty(cdfVal) || !string.IsNullOrEmpty(cdtVal))
                    parts.Add("تاريخ التنفيذ: " + (cdfVal == "" ? "—" : cdfVal) + " إلى " + (cdtVal == "" ? "—" : cdtVal));
                if (parts.Count == 0)
                    parts.Add("تاريخ الطباعة: " + today.ToString("yyyy/MM/dd"));
            }
            @string.Join("  |  ", parts)
        </p>
    </div>

    <!-- Screen header -->
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 no-print">
        <div>
            <h5 class="mb-0"><i class="bi bi-clipboard2-check me-2"></i>تقرير الأعمال المنجزة</h5>
            <small class="opacity-75">الخطوات المكتملة مع تاريخ التجهيز وتاريخ التنفيذ الفعلي</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Schedule" asp-controller="EmployeeOnboarding" class="btn btn-light btn-sm">
                <i class="bi bi-calendar-check me-1"></i> جدول المندوب
            </a>
            <a asp-action="Index" asp-controller="EmployeeOnboarding" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-right me-1"></i> قائمة السائقين
            </a>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" class="filter-section no-print">
        <div class="row g-3">
            <!-- Employee / Company -->
            <div class="col-md-3">
                <div class="filter-group-label">السائق / الشركة</div>
                <input type="text" name="nameSearch" class="form-control form-control-sm mb-2"
                       placeholder="ابحث بالاسم" value="@ViewBag.NameSearch" />
                <select name="companyId" class="form-select form-select-sm" asp-items="ViewBag.Companies" dir="rtl">
                    <option value="">-- كل الشركات --</option>
                </select>
            </div>
            <!-- Target date range -->
            <div class="col-md-3">
                <div class="filter-group-label">تاريخ التجهيز (المخطط)</div>
                <div class="d-flex gap-1 align-items-center mb-1">
                    <label class="small text-muted" style="width:22px">من</label>
                    <input type="date" name="targetDateFrom" class="form-control form-control-sm" value="@tdfVal" />
                </div>
                <div class="d-flex gap-1 align-items-center">
                    <label class="small text-muted" style="width:22px">إلى</label>
                    <input type="date" name="targetDateTo" class="form-control form-control-sm" value="@tdtVal" />
                </div>
            </div>
            <!-- Completed date range -->
            <div class="col-md-3">
                <div class="filter-group-label">تاريخ التنفيذ (الفعلي)</div>
                <div class="d-flex gap-1 align-items-center mb-1">
                    <label class="small text-muted" style="width:22px">من</label>
                    <input type="date" name="completedDateFrom" class="form-control form-control-sm" value="@cdfVal" />
                </div>
                <div class="d-flex gap-1 align-items-center">
                    <label class="small text-muted" style="width:22px">إلى</label>
                    <input type="date" name="completedDateTo" class="form-control form-control-sm" value="@cdtVal" />
                </div>
            </div>
            <!-- Buttons -->
            <div class="col-md-3 d-flex flex-column justify-content-end gap-2">
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-search me-1"></i> عرض التقرير
                </button>
                <a asp-action="Report" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x me-1"></i> مسح الفلتر
                </a>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted no-print">
            <i class="bi bi-clipboard2-x fs-1 d-block mb-2"></i>
            <div class="fw-semibold">لا توجد بيانات مطابقة</div>
            <div class="small">جرّب تغيير الفلتر</div>
        </div>
    }
    else
    {
        var totalRows = Model.Count;
        var withTarget = Model.Count(x => x.TargetDate.HasValue);
        var lateCount = Model.Count(x => x.TargetDate.HasValue && x.CompletedDate.HasValue
        && x.CompletedDate.Value > x.TargetDate.Value);
        var onTimeCount = Model.Count(x => x.TargetDate.HasValue && x.CompletedDate.HasValue
        && x.CompletedDate.Value <= x.TargetDate.Value);

        <!-- Summary bar -->
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <span class="fw-semibold text-muted small">
                <i class="bi bi-list-check me-1"></i>@totalRows عمل منجز
            </span>
            @if (onTimeCount > 0)
            {
                <span class="badge bg-success">@onTimeCount في الموعد أو قبله</span>
            }
            @if (lateCount > 0)
            {
                <span class="badge bg-danger">@lateCount متأخر عن الموعد</span>
            }
            @if (withTarget == 0)
            {
                <span class="badge bg-secondary">بدون تاريخ تجهيز مخطط</span>
            }
            <button class="btn btn-outline-secondary btn-sm me-auto no-print" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> طباعة
            </button>
        </div>

        <div class="card shadow-sm" style="border-radius:10px;overflow:hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 report-table">
                    <thead>
                        <tr>
                            <th class="px-3">#</th>
                            <th>السائق</th>
                            <th>الشركة</th>
                            <th>العمل / الخطوة</th>
                            <th>الجهة / الموقع</th>
                            <th class="date-cell">تاريخ التجهيز (المخطط)</th>
                            <th class="date-cell">تاريخ التنفيذ (الفعلي)</th>
                            <th class="date-cell">الفرق</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowNum = 0;
                        }
                        @foreach (var item in Model)
                        {
                            rowNum++;

                            int? diffDays = null;
                            string diffClass = "";
                            string diffText = "—";

                            if (item.TargetDate.HasValue && item.CompletedDate.HasValue)
                            {
                                diffDays = item.CompletedDate.Value.DayNumber - item.TargetDate.Value.DayNumber;
                                diffClass = diffDays > 0 ? "diff-late" : diffDays < 0 ? "diff-early" : "diff-ontime";
                                diffText = diffDays == 0 ? "في الموعد"
                                : diffDays > 0 ? "+" + diffDays + " يوم"
                                : Math.Abs(diffDays.Value) + " يوم مبكر";
                            }

                            <tr>
                                <td class="px-3 text-muted small">@rowNum</td>
                                <td>
                                    <a asp-action="Progress" asp-controller="EmployeeOnboarding"
                                       asp-route-id="@item.EmployeeId"
                                       class="fw-semibold text-decoration-none text-dark no-print">
                                        @item.FullNameAr
                                    </a>
                                    <span class="fw-semibold d-none d-print-inline">@item.FullNameAr</span>
                                    <div class="meta-tag">كود: @item.EmpCode</div>
                                </td>
                                <td><span class="meta-tag">@(item.CompanyName ?? "—")</span></td>
                                <td><span class="step-badge">@item.StepName</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.StepJeha))
                                    {
                                        <div class="meta-tag"><i class="bi bi-building me-1 no-print"></i>@item.StepJeha</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.StepLocation))
                                    {
                                        <div class="meta-tag"><i class="bi bi-geo-alt me-1 no-print"></i>@item.StepLocation</div>
                                    }
                                    @if (string.IsNullOrEmpty(item.StepJeha) && string.IsNullOrEmpty(item.StepLocation))
                                    {
                                        <span class="meta-tag">—</span>
                                    }
                                </td>
                                <td class="date-cell">
                                    @if (item.TargetDate.HasValue)
                                    {
                                        <span>@item.TargetDate.Value.ToString("yyyy/MM/dd")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="date-cell">
                                    @if (item.CompletedDate.HasValue)
                                    {
                                        <span class="text-success">@item.CompletedDate.Value.ToString("yyyy/MM/dd")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="date-cell">
                                    <span class="@diffClass">@diffText</span>
                                </td>
                                <td>
                                    <span class="meta-tag">@(item.Notes ?? "—")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>