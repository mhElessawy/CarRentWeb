@model List<CarRentWeb.Models.EmployeeInfo>

@{
    ViewData["Title"] = "متابعة تجهيز السائقين";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalSteps = (int)ViewBag.TotalSteps;
    var progressData = (Dictionary<int, int>)ViewBag.ProgressData;
}

<style>
    .emp-card {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 10px;
        background: white;
        transition: box-shadow 0.2s, transform 0.15s;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        display: block;
    }

        .emp-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
            transform: translateY(-2px);
            color: inherit;
        }

    .progress-pill {
        height: 8px;
        border-radius: 4px;
        background: #e9ecef;
    }

        .progress-pill .fill {
            height: 100%;
            border-radius: 4px;
            background: linear-gradient(90deg, #0d6efd, #198754);
            transition: width 0.4s;
        }

    .complete-badge {
        background: #d1e7dd;
        color: #0a5c36;
        border-radius: 20px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .inprogress-badge {
        background: #fff3cd;
        color: #664d03;
        border-radius: 20px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .notstarted-badge {
        background: #f8d7da;
        color: #58151c;
        border-radius: 20px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .page-header {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: white;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
    }
</style>

<div class="container-fluid mt-3" dir="rtl">

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0"><i class="bi bi-person-check me-2"></i>متابعة تجهيز السائقين</h5>
            <small class="opacity-75">اختر سائقاً لعرض وتحديث خطوات التجهيز</small>
        </div>
        <a asp-action="Index" asp-controller="DriverOnboardingSteps" class="btn btn-light btn-sm">
            <i class="bi bi-gear me-1"></i>
            إدارة الخطوات
        </a>
    </div>

    @if (totalSteps == 0)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            لم يتم تعريف أي خطوات بعد —
            <a asp-action="Index" asp-controller="DriverOnboardingSteps" class="alert-link">اذهب لتعريف الخطوات</a>
        </div>
    }

    <!-- Search Bar -->
    <form method="get" class="card p-3 mb-3 shadow-sm" style="border-radius:10px">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">كود السائق</label>
                <input type="number" name="searchCode" class="form-control form-control-sm"
                       placeholder="كود السائق" value="@ViewBag.SearchCode" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">اسم السائق</label>
                <input type="text" name="nameSearch" class="form-control form-control-sm"
                       placeholder="ابحث بالاسم" value="@ViewBag.NameSearch" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">الشركة</label>
                <select name="companyId" class="form-select form-select-sm" asp-items="ViewBag.Companies" dir="rtl">
                    <option value="">-- كل الشركات --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-1"></i> بحث
                </button>
            </div>
        </div>
    </form>

    <!-- Summary Chips -->
    @if (Model.Any())
    {
        var doneCount = Model.Count(e => progressData.ContainsKey(e.Id) && progressData[e.Id] == totalSteps && totalSteps > 0);
        var inProgressCount = Model.Count(e => progressData.ContainsKey(e.Id) && progressData[e.Id] > 0 && progressData[e.Id] < totalSteps);
        var notStartedCount = Model.Count - doneCount - inProgressCount;

        <div class="d-flex gap-2 mb-3 flex-wrap">
            <span class="complete-badge"><i class="bi bi-check-all me-1"></i>مكتمل: @doneCount</span>
            <span class="inprogress-badge"><i class="bi bi-hourglass-split me-1"></i>جارٍ: @inProgressCount</span>
            <span class="notstarted-badge"><i class="bi bi-circle me-1"></i>لم يبدأ: @notStartedCount</span>
            <span class="ms-auto text-muted small align-self-center">@Model.Count سائق — @totalSteps خطوة</span>
        </div>
    }

    <!-- Employee Cards -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-people fs-1 d-block mb-2"></i>
            لا يوجد سائقون مطابقون للبحث
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var emp in Model)
            {
                var done = progressData.ContainsKey(emp.Id) ? progressData[emp.Id] : 0;
                var pct = totalSteps > 0 ? (int)Math.Round((double)done / totalSteps * 100) : 0;
                var statusClass = totalSteps == 0 ? "notstarted-badge"
                : done == totalSteps ? "complete-badge"
                : done > 0 ? "inprogress-badge"
                : "notstarted-badge";
                var statusText = totalSteps == 0 ? "لا توجد خطوات"
                : done == totalSteps ? "مكتمل"
                : done > 0 ? "جارٍ التجهيز"
                : "لم يبدأ";

                <div class="col-md-6 col-xl-4">
                    <a asp-action="Progress" asp-route-id="@emp.Id" class="emp-card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="fw-bold">@emp.FullNameAr</div>
                                <div class="text-muted small">
                                    كود: <strong>@emp.EmpCode</strong>
                                    @if (emp.Company != null)
                                    {
                                        <span class="ms-2">| @emp.Company.CompNameAr</span>
                                    }
                                </div>
                            </div>
                            <span class="@statusClass">@statusText</span>
                        </div>

                        @if (totalSteps > 0)
                        {
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <div class="progress-pill flex-grow-1">
                                    <div class="fill" style="width:@pct%"></div>
                                </div>
                                <span class="text-muted small" style="white-space:nowrap">@done / @totalSteps</span>
                            </div>
                        }
                    </a>
                </div>
            }
        </div>
    }
</div>